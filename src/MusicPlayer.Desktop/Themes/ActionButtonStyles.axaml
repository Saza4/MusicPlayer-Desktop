<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Botones de acción (specs: docs/specs/action-buttons.md y docs/specs/redesign-mockups.md): rectángulo redondeado
        de 36 px con borde fino, icono en el color primario y texto en el color de texto; o solo icono con «only».
        Es opt-in con Classes="action": no cambia los ButtonBackground* globales ni ningún otro botón.
        El texto no toma el primario: ThemeFactory solo garantiza 3:1 del color de texto contra el fondo, y un tema de
        usuario podría traer un primario ilegible como texto. El icono sí (se identifica también por el texto y el borde).
        El foco con teclado usa ThemeFocusRingBrush (el color de texto), no el acento: el borde pasa de 1 a 2 px y el
        relleno interior baja 1 px para que nada se mueva.
        Con la clase «compact» en un ancestro (la barra superior, por ancho de ventana) se oculta el texto y quedan los iconos.
    -->

    <Style Selector="Button.action">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Cursor" Value="Hand" />
        <!--  El adorno rectangular de Fluent no sigue el borde redondeado: el foco lo dibuja el propio borde  -->
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="RenderTransform" Value="none" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.action.only">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!--  Solo icono, del mismo alto que los demás y con borde (Configuración en la barra superior)  -->
    <Style Selector="Button.action.square">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Button.action.square PathIcon">
        <Setter Property="Width" Value="17" />
        <Setter Property="Height" Value="17" />
    </Style>

    <Style Selector="Button.action /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeOverlayBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>
    <!--  El «+» de COLECCIONES no lleva borde: es un control secundario dentro de la barra lateral  -->
    <Style Selector="Button.action.only /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Button.action:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ThemeOverlayHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeOverlayBorderBrush}" />
    </Style>
    <Style Selector="Button.action.only:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.action:pressed">
        <Setter Property="RenderTransform" Value="scale(0.97)" />
    </Style>
    <Style Selector="Button.action:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ThemeOverlayPressedBrush}" />
    </Style>
    <Style Selector="Button.action:disabled">
        <Setter Property="Opacity" Value="0.5" />
    </Style>
    <Style Selector="Button.action:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <!--  Va después de los demás estados: con teclado el anillo se ve también sobre hover y pressed  -->
    <Style Selector="Button.action:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeFocusRingBrush}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Button.action:not(.only):not(.square):focus-visible">
        <Setter Property="Padding" Value="11,0" />
    </Style>

    <Style Selector="Button.action PathIcon">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Foreground" Value="{DynamicResource ThemePrimaryBrush}" />
    </Style>
    <Style Selector="Button.action.only PathIcon">
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
    </Style>

    <!--  Modo compacto: solo iconos (el texto sigue en ToolTip y AutomationProperties.Name)  -->
    <Style Selector=".compact Button.action:not(.only):not(.square)">
        <Setter Property="Padding" Value="10,0" />
    </Style>
    <Style Selector=".compact Button.action:not(.only):not(.square):focus-visible">
        <Setter Property="Padding" Value="9,0" />
    </Style>
    <Style Selector=".compact Button.action TextBlock.label">
        <Setter Property="IsVisible" Value="False" />
    </Style>
</Styles>
