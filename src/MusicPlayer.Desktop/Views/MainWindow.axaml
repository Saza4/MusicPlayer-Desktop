<Window
    x:Class="MusicPlayer.Desktop.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MusicPlayer.Desktop.ViewModels"
    xmlns:controls="using:MusicPlayer.Desktop.Controls"
    Title="Music Player"
    Width="960"
    Height="600"
    MinWidth="640"
    MinHeight="400"
    x:DataType="vm:MainViewModel"
    Background="{DynamicResource ThemeBackgroundBrush}"
    Icon="/Assets/app.ico">

    <Window.Resources>
        <DataTemplate x:Key="LyricLineTemplate" x:DataType="vm:LyricLineViewModel">
            <StackPanel
                Margin="8,6"
                Background="Transparent"
                Classes.active="{Binding IsActive}"
                Classes.synced="{Binding IsSynced}"
                Spacing="2">
                <TextBlock
                    Classes="lead"
                    FontSize="{Binding PronunciationFontSize}"
                    IsVisible="{Binding ShowPronunciation}"
                    Text="{Binding Pronunciation}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Classes="lead"
                    FontSize="{Binding OriginalFontSize}"
                    IsVisible="{Binding ShowOriginal}"
                    Text="{Binding Text}"
                    TextWrapping="Wrap" />
                <TextBlock
                    FontSize="{Binding TranslationFontSize}"
                    FontStyle="Italic"
                    IsVisible="{Binding ShowTranslation}"
                    Text="{Binding Translation}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="Style Selector" />
        <!--  Preservado de estructura base  -->
        <Style Selector="Grid.missing">
            <Setter Property="Opacity" Value="0.45" />
        </Style>
        <Style Selector="ListBox.lyrics ListBoxItem">
            <Setter Property="Padding" Value="0" />
        </Style>
        <!--  La línea activa se resalta con el TextBlock, no con la selección del ListBox  -->
        <Style Selector="ListBox.lyrics ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.lyrics ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.lyrics StackPanel.synced">
            <Setter Property="Opacity" Value="0.45" />
        </Style>
        <Style Selector="ListBox.lyrics StackPanel.synced.active">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="ListBox.lyrics StackPanel.active TextBlock.lead">
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
    </Window.Styles>

    <Grid>
        <DockPanel>

            <!--  Barra superior  -->
            <!--  Con la ventana estrecha, la clase «compact» (MainWindow.axaml.cs) deja los botones de acción solo con icono  -->
            <Border
                x:Name="TopBar"
                Padding="16,12"
                Background="{DynamicResource ThemeSurfaceBrush}"
                BorderBrush="{DynamicResource ThemeOverlayBorderBrush}"
                BorderThickness="0,0,0,1"
                DockPanel.Dock="Top">
                <DockPanel>
                    <Button
                        AutomationProperties.Name="Agregar carpeta"
                        Classes="action"
                        Command="{Binding AddFolderCommand}"
                        DockPanel.Dock="Left"
                        ToolTip.Tip="Agregar carpeta">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="M20 6h-8l-2-2H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm-1 8h-3v3h-2v-3h-3v-2h3V9h2v3h3v2z" />
                            <TextBlock Classes="label" Text="Agregar carpeta" />
                        </StackPanel>
                    </Button>
                    <!--  Autocompletar/Limpiar etiquetas… o editor de etiquetas  -->
                    <Button
                        Margin="8,0,0,0"
                        AutomationProperties.Name="Limpiar etiquetas"
                        Classes="action"
                        Command="{Binding OpenAutoFixCommand}"
                        DockPanel.Dock="Left"
                        ToolTip.Tip="Limpiar etiquetas">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="M21.41 11.58l-9-9C12.05 2.22 11.55 2 11 2H4c-1.1 0-2 .9-2 2v7c0 .55.22 1.05.59 1.42l9 9c.36.36.86.58 1.41.58.55 0 1.05-.22 1.41-.59l7-7c.37-.36.59-.86.59-1.41 0-.55-.23-1.06-.59-1.42zM5.5 7C4.67 7 4 6.33 4 5.5S4.67 4 5.5 4 7 4.67 7 5.5 6.33 7 5.5 7z" />
                            <TextBlock Classes="label" Text="Limpiar etiquetas" />
                        </StackPanel>
                    </Button>
                    <Button
                        Margin="8,0,0,0"
                        AutomationProperties.Name="Convertir lo que veo"
                        Classes="action"
                        Command="{Binding OpenConvertCommand}"
                        DockPanel.Dock="Left"
                        ToolTip.Tip="Convertir lo que veo">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="M18 12l4-4-4-4v3H3v2h15v3zM6 12l-4 4 4 4v-3h15v-2H6v-3z" />
                            <TextBlock Classes="label" Text="Convertir lo que veo…" />
                        </StackPanel>
                    </Button>
                    <!--  Tema: la lista previsualiza al pasar el cursor o con las flechas; clic o Enter confirma  -->
                    <Button
                        x:Name="ThemeButton"
                        Margin="8,0,0,0"
                        AutomationProperties.Name="Tema"
                        Classes="action"
                        DockPanel.Dock="Right"
                        ToolTip.Tip="Cambiar el tema">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Data="M12 3c-4.97 0-9 4.03-9 9s4.03 9 9 9c.83 0 1.5-.67 1.5-1.5 0-.39-.15-.74-.39-1.01-.23-.26-.38-.61-.38-.99 0-.83.67-1.5 1.5-1.5H16c2.76 0 5-2.24 5-5 0-4.42-4.03-8-9-8zm-5.5 9c-.83 0-1.5-.67-1.5-1.5S5.67 9 6.5 9 8 9.67 8 10.5 7.33 12 6.5 12zm3-4C8.67 8 8 7.33 8 6.5S8.67 5 9.5 5s1.5.67 1.5 1.5S10.33 8 9.5 8zm5 0c-.83 0-1.5-.67-1.5-1.5S13.67 5 14.5 5s1.5.67 1.5 1.5S15.33 8 14.5 8zm3 4c-.83 0-1.5-.67-1.5-1.5S16.67 9 17.5 9s1.5.67 1.5 1.5-.67 1.5-1.5 1.5z" />
                                <TextBlock Classes="label" Text="Tema" />
                            </StackPanel>
                        </Button.Content>
                        <Button.Flyout>
                            <Flyout
                                Closed="OnThemeFlyoutClosed"
                                Opened="OnThemeFlyoutOpened"
                                Placement="BottomEdgeAlignedRight">
                                <StackPanel Width="220" Spacing="8">
                                    <ListBox
                                        x:Name="ThemeList"
                                        ItemsSource="{Binding Themes.Items}"
                                        PointerExited="OnThemeListPointerExited"
                                        PointerMoved="OnThemeListPointerMoved"
                                        SelectedItem="{Binding Themes.SelectedChoice}"
                                        Tapped="OnThemeListTapped">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ThemeChoice">
                                                <TextBlock Text="{Binding Name}" />
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <Button
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        Click="OnOpenThemesFolder"
                                        Content="Carpeta de temas"
                                        Focusable="False" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <TextBox
                        Width="240"
                        DockPanel.Dock="Right"
                        Text="{Binding SearchText}"
                        Watermark="Buscar por título, artista o álbum" />
                    <TextBlock
                        Margin="16,0"
                        VerticalAlignment="Center"
                        Opacity="0.7"
                        Text="{Binding Status}"
                        TextTrimming="CharacterEllipsis"
                        ToolTip.Tip="{Binding Status}" />
                </DockPanel>
            </Border>

            <!--  Convertir formato  -->
            <Border
                Padding="16,12"
                Background="{DynamicResource ThemeSurfaceBrush}"
                DockPanel.Dock="Top"
                IsVisible="{Binding Conversion.IsOpen}">
                <StackPanel Spacing="8">
                    <TextBlock
                        FontWeight="SemiBold"
                        Text="{Binding Conversion.Heading}"
                        TextWrapping="Wrap" />

                    <TextBlock
                        Foreground="{DynamicResource ThemeDangerBrush}"
                        IsVisible="{Binding !Conversion.HasConverter}"
                        Text="No se encontró ffmpeg. Instálalo (en Windows: winget install Gyan.FFmpeg), reinicia la app y vuelve a intentarlo."
                        TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <StackPanel Spacing="2">
                            <TextBlock
                                FontSize="12"
                                Opacity="0.7"
                                Text="Formato" />
                            <ComboBox
                                MinWidth="110"
                                ItemsSource="{Binding Conversion.Formats}"
                                SelectedItem="{Binding Conversion.Format}" />
                        </StackPanel>
                        <StackPanel IsVisible="{Binding Conversion.UsesBitrate}" Spacing="2">
                            <TextBlock
                                FontSize="12"
                                Opacity="0.7"
                                Text="Calidad (kbps)" />
                            <ComboBox
                                MinWidth="110"
                                ItemsSource="{Binding Conversion.Bitrates}"
                                SelectedItem="{Binding Conversion.Bitrate}" />
                        </StackPanel>
                    </StackPanel>

                    <CheckBox Content="Agregar los archivos nuevos a la biblioteca" IsChecked="{Binding Conversion.AddToLibrary}" />
                    <TextBlock
                        FontSize="12"
                        Opacity="0.6"
                        Text="Los originales no se modifican: el resultado queda junto a ellos. Convertir de MP3 o M4A a FLAC o WAV no mejora la calidad."
                        TextWrapping="Wrap" />
                    <TextBlock IsVisible="{Binding Conversion.IsBusy}" Text="{Binding Conversion.ProgressText}" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Command="{Binding Conversion.StartCommand}" Content="Convertir" />
                        <Button Command="{Binding Conversion.CancelCommand}" Content="Cancelar" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  Vista previa de sugerencias  -->
            <Border
                Padding="16,12"
                Background="{DynamicResource ThemeSurfaceBrush}"
                DockPanel.Dock="Top"
                IsVisible="{Binding AutoFix.IsOpen}">
                <StackPanel Spacing="8">
                    <TextBlock
                        FontWeight="SemiBold"
                        Text="{Binding AutoFix.Heading}"
                        TextWrapping="Wrap" />
                    <CheckBox Content="Usar la carpeta como álbum si falta" IsChecked="{Binding AutoFix.AlbumFromFolder}" />

                    <ListBox MaxHeight="260" ItemsSource="{Binding AutoFix.Items}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:TagSuggestionItemViewModel">
                                <CheckBox Margin="4" IsChecked="{Binding IsSelected}">
                                    <StackPanel Spacing="2">
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Text="{Binding FileName}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            FontSize="12"
                                            Opacity="0.75"
                                            Text="{Binding ChangesText}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </CheckBox>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock
                        FontSize="12"
                        Opacity="0.6"
                        Text="Se escribe en los archivos. Si suena alguna de estas canciones, se detendrá. Podrás deshacerlo después."
                        TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Command="{Binding AutoFix.ApplyCommand}" Content="{Binding AutoFix.ApplyText}" />
                        <Button Command="{Binding AutoFix.SelectAllCommand}" Content="Todas" />
                        <Button Command="{Binding AutoFix.SelectNoneCommand}" Content="Ninguna" />
                        <Button Command="{Binding AutoFix.CancelCommand}" Content="Cancelar" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  Deshacer el último lote  -->
            <Border
                Padding="16,10"
                Background="{DynamicResource ThemeSuccessBarBrush}"
                DockPanel.Dock="Top"
                IsVisible="{Binding AutoFix.HasUndo}">
                <DockPanel>
                    <StackPanel
                        DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button Command="{Binding AutoFix.UndoCommand}" Content="Deshacer" />
                        <Button Command="{Binding AutoFix.DismissUndoCommand}" Content="Cerrar" />
                    </StackPanel>
                    <TextBlock
                        Margin="0,0,16,0"
                        VerticalAlignment="Center"
                        Text="{Binding AutoFix.UndoText}"
                        TextWrapping="Wrap" />
                </DockPanel>
            </Border>

            <!--  Barra de confirmación de eliminación  -->
            <Border
                Padding="16,10"
                Background="{DynamicResource ThemeDangerBarBrush}"
                DockPanel.Dock="Top"
                IsVisible="{Binding IsConfirmingDelete}">
                <DockPanel>
                    <StackPanel
                        DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button Command="{Binding ConfirmDeleteTrackCommand}" Content="Eliminar del disco" />
                        <Button Command="{Binding CancelDeleteTrackCommand}" Content="Cancelar" />
                    </StackPanel>
                    <TextBlock
                        Margin="0,0,16,0"
                        VerticalAlignment="Center"
                        Text="{Binding DeletePrompt}"
                        TextWrapping="Wrap" />
                </DockPanel>
            </Border>

            <!--  Barra de aviso  -->
            <Border
                Padding="16,10"
                Background="{DynamicResource ThemeWarningBarBrush}"
                DockPanel.Dock="Top"
                IsVisible="{Binding HasMissing}">
                <DockPanel>
                    <StackPanel
                        DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button
                            Command="{Binding CheckAvailabilityCommand}"
                            Content="Volver a revisar"
                            IsVisible="{Binding !IsConfirmingPrune}" />
                        <Button
                            Command="{Binding AskPruneCommand}"
                            Content="Quitar de la biblioteca…"
                            IsVisible="{Binding !IsConfirmingPrune}" />
                        <Button
                            Command="{Binding ConfirmPruneCommand}"
                            Content="Quitar"
                            IsVisible="{Binding IsConfirmingPrune}" />
                        <Button
                            Command="{Binding CancelPruneCommand}"
                            Content="Cancelar"
                            IsVisible="{Binding IsConfirmingPrune}" />
                    </StackPanel>
                    <TextBlock
                        Margin="0,0,16,0"
                        VerticalAlignment="Center"
                        Text="{Binding MissingPrompt}"
                        TextWrapping="Wrap" />
                </DockPanel>
            </Border>

            <Border
                Padding="16,12"
                Background="{DynamicResource ThemeSurfaceBrush}"
                DockPanel.Dock="Top"
                IsVisible="{Binding TagEditor.IsOpen}">
                <StackPanel Spacing="8">
                    <TextBlock
                        FontWeight="SemiBold"
                        Text="{Binding TagEditor.Heading}"
                        TextTrimming="CharacterEllipsis" />
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
                        <StackPanel
                            Grid.Row="0"
                            Grid.Column="0"
                            Margin="0,0,8,8"
                            Spacing="2">
                            <TextBlock
                                FontSize="12"
                                Opacity="0.7"
                                Text="Título" />
                            <TextBox Text="{Binding TagEditor.Title}" />
                        </StackPanel>
                        <StackPanel
                            Grid.Row="0"
                            Grid.Column="1"
                            Margin="0,0,0,8"
                            Spacing="2">
                            <TextBlock
                                FontSize="12"
                                Opacity="0.7"
                                Text="Artista" />
                            <TextBox Text="{Binding TagEditor.Artist}" />
                        </StackPanel>
                        <StackPanel
                            Grid.Row="1"
                            Grid.Column="0"
                            Margin="0,0,8,0"
                            Spacing="2">
                            <TextBlock
                                FontSize="12"
                                Opacity="0.7"
                                Text="Álbum" />
                            <TextBox Text="{Binding TagEditor.Album}" />
                        </StackPanel>
                        <StackPanel
                            Grid.Row="1"
                            Grid.Column="1"
                            Spacing="2">
                            <TextBlock
                                FontSize="12"
                                Opacity="0.7"
                                Text="Artista del álbum" />
                            <TextBox Text="{Binding TagEditor.AlbumArtist}" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border
                            Width="96"
                            Height="96"
                            Background="{DynamicResource ThemeOverlayCoverBrush}"
                            ClipToBounds="True"
                            CornerRadius="6">
                            <Panel>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="36"
                                    Opacity="0.4"
                                    Text="♪" />
                                <Image Source="{Binding TagEditor.CoverPreview}" Stretch="UniformToFill" />
                            </Panel>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="6">
                            <TextBlock
                                FontSize="12"
                                Opacity="0.7"
                                Text="Carátula (JPG o PNG)" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Command="{Binding TagEditor.ChooseCoverCommand}" Content="Elegir imagen…" />
                                <Button Command="{Binding TagEditor.RemoveCoverCommand}" Content="Quitar" />
                            </StackPanel>
                            <TextBlock
                                FontSize="12"
                                Opacity="0.6"
                                Text="{Binding TagEditor.CoverNote}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <StackPanel Spacing="2">
                            <TextBlock
                                FontSize="12"
                                Opacity="0.7"
                                Text="Año" />
                            <TextBox Width="90" Text="{Binding TagEditor.YearText}" />
                        </StackPanel>
                        <StackPanel Spacing="2">
                            <TextBlock
                                FontSize="12"
                                Opacity="0.7"
                                Text="Pista" />
                            <TextBox Width="90" Text="{Binding TagEditor.TrackText}" />
                        </StackPanel>
                        <StackPanel Spacing="2">
                            <TextBlock
                                FontSize="12"
                                Opacity="0.7"
                                Text="Disco" />
                            <TextBox Width="90" Text="{Binding TagEditor.DiscText}" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock
                        Foreground="{DynamicResource ThemeDangerBrush}"
                        IsVisible="{Binding TagEditor.HasError}"
                        Text="{Binding TagEditor.Error}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        FontSize="12"
                        Opacity="0.6"
                        Text="Se escribe en el archivo. Si esta canción suena, se detendrá. Un campo vacío borra la etiqueta."
                        TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Command="{Binding TagEditor.SaveCommand}" Content="Guardar" />
                        <Button Command="{Binding TagEditor.CancelCommand}" Content="Cancelar" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  Controles de reproducción: [carátula + título] [controles + progreso] [letra, pantalla completa, volumen]  -->
            <Border
                Padding="16,12"
                Background="{DynamicResource ThemeSurfaceBrush}"
                BorderBrush="{DynamicResource ThemeOverlayBorderBrush}"
                BorderThickness="0,1,0,0"
                DockPanel.Dock="Bottom">
                <Grid ColumnDefinitions="*,2*,*">

                    <!--  Izquierda: carátula y título  -->
                    <Grid
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        ColumnDefinitions="Auto,*">
                        <Button
                            Width="48"
                            Height="48"
                            Padding="0"
                            ClipToBounds="True"
                            Command="{Binding OpenImmersiveCommand}"
                            ToolTip.Tip="Pantalla completa">
                            <Panel>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="22"
                                    Opacity="0.5"
                                    Text="♪" />
                                <Image Source="{Binding NowPlayingCover}" Stretch="UniformToFill" />
                            </Panel>
                        </Button>
                        <TextBlock
                            Grid.Column="1"
                            Margin="12,0,12,0"
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Text="{Binding NowPlaying}"
                            TextTrimming="CharacterEllipsis" />
                    </Grid>

                    <!--  Centro: Aleatorio · Anterior · Reproducir/Pausa · Siguiente · Repetir, y progreso  -->
                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Spacing="6">
                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="8">
                            <ToggleButton
                                AutomationProperties.Name="Aleatorio"
                                Classes="icon"
                                Classes.active="{Binding IsShuffleOn}"
                                IsChecked="{Binding IsShuffleOn}"
                                ToolTip.Tip="Aleatorio">
                                <Panel Width="36" Height="36">
                                    <PathIcon
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Data="M10.59 9.17L5.41 4 4 5.41l5.17 5.17 1.42-1.41zM14.5 4l2.04 2.04L4 18.59 5.41 20 17.96 7.46 20 9.5V4h-5.5zm.33 9.41l-1.41 1.41 3.13 3.13L14.5 20H20v-5.5l-2.04 2.04-3.13-3.13z" />
                                    <Ellipse
                                        Width="4"
                                        Height="4"
                                        Margin="0,0,0,3"
                                        VerticalAlignment="Bottom"
                                        Fill="{DynamicResource ThemeAccentBrush}"
                                        IsVisible="{Binding IsShuffleOn}" />
                                </Panel>
                            </ToggleButton>
                            <Button
                                AutomationProperties.Name="Anterior"
                                Classes="icon skip"
                                Command="{Binding PreviousCommand}"
                                ToolTip.Tip="Anterior">
                                <PathIcon Data="M6 6h2v12H6zm3.5 6l8.5 6V6z" />
                            </Button>
                            <Button
                                AutomationProperties.Name="{Binding PlayPauseText}"
                                Classes="play"
                                Command="{Binding TogglePlayPauseCommand}"
                                ToolTip.Tip="{Binding PlayPauseText}">
                                <Panel Classes="pp" Classes.playing="{Binding IsPlaying}">
                                    <PathIcon Classes="glyph-play" Data="M8 5v14l11-7z" />
                                    <PathIcon Classes="glyph-pause" Data="M6 19h4V5H6v14zm8-14v14h4V5h-4z" />
                                </Panel>
                            </Button>
                            <Button
                                AutomationProperties.Name="Siguiente"
                                Classes="icon skip"
                                Command="{Binding NextCommand}"
                                ToolTip.Tip="Siguiente">
                                <PathIcon Data="M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z" />
                            </Button>
                            <Button
                                AutomationProperties.Name="{Binding RepeatText}"
                                Classes="icon"
                                Classes.active="{Binding RepeatText, Converter={x:Static ObjectConverters.NotEqual}, ConverterParameter='Repetir: no'}"
                                Command="{Binding CycleRepeatCommand}"
                                ToolTip.Tip="{Binding RepeatText}">
                                <Panel Width="36" Height="36">
                                    <PathIcon
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Data="M7 7h10v3l4-4-4-4v3H5v6h2V7zm10 10H7v-3l-4 4 4 4v-3h12v-6h-2v4z" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="8"
                                        FontWeight="Bold"
                                        IsVisible="{Binding RepeatText, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='Repetir: una'}"
                                        Text="1" />
                                    <Ellipse
                                        Width="4"
                                        Height="4"
                                        Margin="0,0,0,3"
                                        VerticalAlignment="Bottom"
                                        Fill="{DynamicResource ThemeAccentBrush}"
                                        IsVisible="{Binding RepeatText, Converter={x:Static ObjectConverters.NotEqual}, ConverterParameter='Repetir: no'}" />
                                </Panel>
                            </Button>
                        </StackPanel>
                        <Grid ColumnDefinitions="56,*,56">
                            <TextBlock
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Text="{Binding PositionText}" />
                            <Slider
                                Grid.Column="1"
                                Maximum="{Binding DurationSeconds}"
                                Minimum="0"
                                Value="{Binding PositionSeconds}" />
                            <TextBlock
                                Grid.Column="2"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Text="{Binding DurationText}" />
                        </Grid>
                    </StackPanel>

                    <!--  Derecha: Letra, Pantalla completa, Isla flotante y Volumen  -->
                    <StackPanel
                        Grid.Column="2"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="4">
                        <Button
                            AutomationProperties.Name="Letra"
                            Classes="icon"
                            Classes.active="{Binding Lyrics.ShowPanel}"
                            Command="{Binding Lyrics.ToggleOpenCommand}"
                            IsEnabled="{Binding Lyrics.IsAvailable}"
                            ToolTip.Tip="Letra">
                            <PathIcon Data="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zM4 12h4v2H4v-2zm10 6H4v-2h10v2zm6 0h-4v-2h4v2zm0-4H10v-2h10v2z" />
                        </Button>
                        <Button
                            AutomationProperties.Name="Pantalla completa"
                            Classes="icon"
                            Command="{Binding OpenImmersiveCommand}"
                            ToolTip.Tip="Pantalla completa">
                            <PathIcon Data="M7 14H5v5h5v-2H7v-3zm-2-4h2V7h3V5H5v5zm12 7h-3v2h5v-5h-2v3zM14 5v2h3v3h2V5h-5z" />
                        </Button>
                        <!--
                            Isla flotante (solo Windows). Button con comando y no ToggleButton, para no pelear con el
                            atajo global de Espacio. Acento cuando está activada; el texto dice lo que hará el clic.
                        -->
                        <Button
                            AutomationProperties.Name="{Binding IslandToggleText}"
                            Classes="icon"
                            Classes.active="{Binding ShowIsland}"
                            Command="{Binding ToggleIslandCommand}"
                            IsVisible="{Binding IsIslandSupported}"
                            ToolTip.Tip="{Binding IslandToggleText}">
                            <PathIcon Data="M2 4h20v16H2V4zm2 2v12h16V6H4zm4 1h8a1.5 1.5 0 0 1 0 3H8a1.5 1.5 0 0 1 0-3z" />
                        </Button>
                        <Button
                            Margin="8,0,0,0"
                            AutomationProperties.Name="{Binding MuteText}"
                            Classes="icon"
                            Command="{Binding ToggleMuteCommand}"
                            ToolTip.Tip="{Binding MuteText, StringFormat='{}{0} (M)'}">
                            <Panel>
                                <PathIcon Data="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z" IsVisible="{Binding !IsMuted}" />
                                <PathIcon Data="M16.5 12c0-1.77-1.02-3.29-2.5-4.03v2.21l2.45 2.45c.03-.2.05-.41.05-.63zm2.5 0c0 .94-.2 1.82-.54 2.64l1.51 1.51C20.63 14.91 21 13.5 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3L3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06c1.38-.31 2.63-.95 3.69-1.81L19.73 21 21 19.73l-9-9L4.27 3zM12 4L9.91 6.09 12 8.18V4z" IsVisible="{Binding IsMuted}" />
                            </Panel>
                        </Button>
                        <Slider
                            Width="100"
                            VerticalAlignment="Center"
                            Maximum="1"
                            Minimum="0"
                            Value="{Binding Volume}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!--  Barra lateral, Lista de canciones y Panel de letras  -->
            <Grid ColumnDefinitions="220,*,Auto">
                <DockPanel Grid.Column="0" Margin="8,8,0,8">
                    <!--  Panel de edición (crear / renombrar / confirmar eliminación)  -->
                    <Border
                        Margin="0,8,0,0"
                        Padding="8"
                        Background="{DynamicResource ThemeSurfaceBrush}"
                        CornerRadius="8"
                        DockPanel.Dock="Bottom"
                        IsVisible="{Binding Playlists.IsEditing}">
                        <StackPanel Spacing="6">
                            <TextBlock
                                FontWeight="SemiBold"
                                Text="{Binding Playlists.Prompt}"
                                TextWrapping="Wrap" />
                            <TextBox
                                x:Name="PlaylistNameBox"
                                IsVisible="{Binding Playlists.IsNameInput}"
                                KeyDown="OnPlaylistNameKeyDown"
                                MaxLength="80"
                                Text="{Binding Playlists.NameDraft}"
                                Watermark="Nombre" />
                            <TextBlock
                                Foreground="{DynamicResource ThemeDangerBrush}"
                                IsVisible="{Binding Playlists.HasEditError}"
                                Text="{Binding Playlists.EditError}"
                                TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Command="{Binding Playlists.ConfirmEditCommand}" Content="{Binding Playlists.ConfirmText}" />
                                <Button Command="{Binding Playlists.CancelEditCommand}" Content="Cancelar" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <!--  Renombrar / eliminar: solo con una playlist seleccionada  -->
                    <StackPanel
                        Margin="0,8,0,0"
                        DockPanel.Dock="Bottom"
                        IsVisible="{Binding Playlists.HasPlaylistSelected}"
                        Orientation="Horizontal"
                        Spacing="6">
                        <Button Command="{Binding Playlists.BeginRenameCommand}" Content="Renombrar" />
                        <Button Command="{Binding Playlists.BeginDeleteCommand}" Content="Eliminar" />
                    </StackPanel>
                    <DockPanel Margin="0,0,0,6" DockPanel.Dock="Top">
                        <Button
                            AutomationProperties.Name="Nueva playlist"
                            Classes="action only"
                            Command="{Binding Playlists.BeginCreateCommand}"
                            DockPanel.Dock="Right"
                            ToolTip.Tip="Nueva playlist">
                            <PathIcon Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" />
                        </Button>
                        <TextBlock
                            Margin="8,0"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Opacity="0.6"
                            Text="COLECCIONES" />
                    </DockPanel>
                    <ListBox ItemsSource="{Binding Playlists.Items}" SelectedItem="{Binding Playlists.Selected}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:PlaylistItemViewModel">
                                <DockPanel Margin="4">
                                    <TextBlock
                                        Margin="8,0,0,0"
                                        DockPanel.Dock="Right"
                                        Opacity="0.6"
                                        Text="{Binding CountText}" />
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <DockPanel Grid.Column="1" Margin="8">
                    <TabStrip
                        Margin="0,0,0,6"
                        DockPanel.Dock="Top"
                        IsVisible="{Binding ShowModeTabs}"
                        SelectedIndex="{Binding BrowseIndex}">
                        <TabStripItem Content="Canciones" />
                        <TabStripItem Content="Álbumes" />
                        <TabStripItem Content="Artistas" />
                    </TabStrip>
                    <DockPanel
                        Margin="0,0,0,6"
                        DockPanel.Dock="Top"
                        IsVisible="{Binding ShowBackBar}">
                        <Button
                            Command="{Binding GoBackCommand}"
                            Content="{Binding BackText}"
                            DockPanel.Dock="Left" />
                        <Button
                            Command="{Binding PlayScopeCommand}"
                            Content="▶ Reproducir"
                            DockPanel.Dock="Right" />
                        <TextBlock
                            Margin="12,0"
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Text="{Binding BrowseTitle}"
                            TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <Panel>
                        <!--  Canciones: el mismo ListBox de antes, con IsVisible nuevo  -->
                        <ListBox
                            x:Name="SongList"
                            ContextRequested="OnTrackListContextRequested"
                            DoubleTapped="OnTrackDoubleTapped"
                            IsVisible="{Binding ShowSongs}"
                            ItemsSource="{Binding Tracks}"
                            SelectedItem="{Binding SelectedTrack}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:TrackItemViewModel">
                                    <Grid
                                        Margin="8,4"
                                        Classes.missing="{Binding !IsAvailable}"
                                        ColumnDefinitions="Auto,3*,2*,Auto">
                                        <!--  Thumbnail de Canciones  -->
                                        <Border
                                            Grid.Column="0"
                                            Width="40"
                                            Height="40"
                                            Margin="0,0,12,0"
                                            Background="{DynamicResource ThemeOverlayCoverBrush}"
                                            ClipToBounds="True"
                                            CornerRadius="4">
                                            <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                                        </Border>
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Text="{Binding Title}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Opacity="0.7"
                                            Text="{Binding Artist}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Grid.Column="3"
                                            Margin="12,0,0,0"
                                            VerticalAlignment="Center"
                                            Opacity="0.7"
                                            Text="{Binding TrailingText}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <ListBox
                            IsVisible="{Binding ShowAlbums}"
                            ItemsSource="{Binding Albums}"
                            Tapped="OnBrowseTapped">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:AlbumItemViewModel">
                                    <Grid Margin="8,4" ColumnDefinitions="Auto,*">
                                        <!--  Thumbnail de Álbumes  -->
                                        <Border
                                            Width="56"
                                            Height="56"
                                            Margin="0,0,12,0"
                                            Background="{DynamicResource ThemeOverlayCoverBrush}"
                                            ClipToBounds="True"
                                            CornerRadius="4">
                                            <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                                        </Border>
                                        <StackPanel
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Spacing="2">
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                Text="{Binding Title}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Opacity="0.7"
                                                Text="{Binding Subtitle}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <ListBox
                            IsVisible="{Binding ShowArtists}"
                            ItemsSource="{Binding Artists}"
                            Tapped="OnBrowseTapped">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:ArtistItemViewModel">
                                    <Grid Margin="8,4" ColumnDefinitions="Auto,*">
                                        <!--  Thumbnail de Artistas  -->
                                        <Border
                                            Width="56"
                                            Height="56"
                                            Margin="0,0,12,0"
                                            Background="{DynamicResource ThemeOverlayCoverBrush}"
                                            ClipToBounds="True"
                                            CornerRadius="4">
                                            <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                                        </Border>
                                        <StackPanel
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Spacing="2">
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                Text="{Binding Name}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock Opacity="0.7" Text="{Binding Summary}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Panel>
                </DockPanel>

                <Border
                    Grid.Column="2"
                    Width="380"
                    Margin="0,8,8,8"
                    Padding="8"
                    Background="{DynamicResource ThemeSurfaceBrush}"
                    BorderBrush="{DynamicResource ThemeOverlayBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    IsVisible="{Binding Lyrics.ShowPanel}">
                    <DockPanel>
                        <Button
                            Margin="0,0,0,8"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Content="Traducción y pronunciación"
                            DockPanel.Dock="Top">
                            <Button.Flyout>
                                <Flyout Placement="Bottom">
                                    <StackPanel MinWidth="260" Spacing="4">
                                        <CheckBox
                                            Content="Mostrar traducción"
                                            IsChecked="{Binding Lyrics.ShowTranslation}"
                                            IsEnabled="{Binding Lyrics.HasTranslation}" />
                                        <CheckBox
                                            Content="Mostrar pronunciación"
                                            IsChecked="{Binding Lyrics.ShowPronunciation}"
                                            IsEnabled="{Binding Lyrics.HasPronunciation}" />
                                        <CheckBox
                                            Content="Ocultar original"
                                            IsChecked="{Binding Lyrics.HideOriginal}"
                                            IsEnabled="{Binding Lyrics.HasExtras}" />
                                        <Separator Margin="0,4" />
                                        <CheckBox
                                            Content="Pronunciación en texto grande"
                                            IsChecked="{Binding Lyrics.EmphasizePronunciation}"
                                            IsEnabled="{Binding Lyrics.HasPronunciation}" />
                                        <TextBlock
                                            FontSize="12"
                                            IsVisible="{Binding !Lyrics.HasExtras}"
                                            Opacity="0.6"
                                            Text="Esta canción no tiene archivos .lrc de traducción ni de pronunciación."
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <ListBox
                            Background="Transparent"
                            Classes="lyrics"
                            ItemTemplate="{StaticResource LyricLineTemplate}"
                            ItemsSource="{Binding Lyrics.Lines}"
                            SelectedIndex="{Binding Lyrics.ActiveIndex, Mode=OneWay}"
                            Tapped="OnLyricTapped" />
                    </DockPanel>
                </Border>
            </Grid>

        </DockPanel>

        <!--  Modo inmersivo  -->
        <ThemeVariantScope RequestedThemeVariant="Dark">
            <Grid Background="#FF101010" IsVisible="{Binding IsImmersive}">
                <!--  Fondo: la portada ampliada y desenfocada, una sola vez (no un Effect que se recalcula en cada fotograma)  -->
                <controls:BlurredBackdrop
                    BlurRadius="60"
                    Opacity="0.9"
                    RenderOptions.BitmapInterpolationMode="HighQuality"
                    Source="{Binding NowPlayingCover}" />
                <!--  Velo en degradado para que el texto siempre se lea  -->
                <Border>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                            <GradientStop Offset="0" Color="#99000000" />
                            <GradientStop Offset="1" Color="#E6000000" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Button
                    Margin="16"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    AutomationProperties.Name="Cerrar"
                    Classes="icon"
                    Command="{Binding CloseImmersiveCommand}"
                    ToolTip.Tip="Cerrar">
                    <PathIcon Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" />
                </Button>
                <!--
                    Capas de la letra (docs/specs/lyrics-layers.md, criterios 12-16): burbuja con una «A», distinta del
                    icono de «Letra». Las opciones se calculan en Core al abrir el menú (OnLayersMenuOpening).
                -->
                <Button
                    x:Name="LayersButton"
                    Margin="16"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    AutomationProperties.Name="Traducción y pronunciación"
                    Classes="icon"
                    IsVisible="{Binding Lyrics.ShowLayersButton}"
                    ToolTip.Tip="Traducción y pronunciación">
                    <PathIcon Data="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm0 14H6l-2 2V4h16v12zM11.3 6h1.4l2.8 8h-1.5l-.6-1.8h-2.8l-.6 1.8H8.5zm-.3 5h2l-1-3z" />
                    <Button.Flyout>
                        <MenuFlyout
                            Closed="OnLayersMenuClosed"
                            Opened="OnLayersMenuOpened"
                            Opening="OnLayersMenuOpening"
                            Placement="BottomEdgeAlignedRight" />
                    </Button.Flyout>
                </Button>
                <Grid Margin="48,72,48,32" ColumnDefinitions="*,*">
                    <!--  Izquierda: carátula, datos y controles  -->
                    <StackPanel
                        Grid.Column="0"
                        MaxWidth="400"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="16">
                        <Border
                            Width="360"
                            Height="360"
                            Background="#22FFFFFF"
                            ClipToBounds="True"
                            CornerRadius="12">
                            <Panel>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="96"
                                    Opacity="0.4"
                                    Text="♪" />
                                <Image Source="{Binding NowPlayingCover}" Stretch="UniformToFill" />
                            </Panel>
                        </Border>
                        <StackPanel Spacing="2">
                            <TextBlock
                                FontSize="22"
                                FontWeight="Bold"
                                Text="{Binding CurrentTrack.Title}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Opacity="0.7"
                                Text="{Binding CurrentTrack.Artist}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Grid ColumnDefinitions="48,*,48">
                            <TextBlock
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Text="{Binding PositionText}" />
                            <Slider
                                Grid.Column="1"
                                Maximum="{Binding DurationSeconds}"
                                Minimum="0"
                                Value="{Binding PositionSeconds}" />
                            <TextBlock
                                Grid.Column="2"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Text="{Binding DurationText}" />
                        </Grid>
                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="8">
                            <ToggleButton
                                AutomationProperties.Name="Aleatorio"
                                Classes="icon"
                                Classes.active="{Binding IsShuffleOn}"
                                IsChecked="{Binding IsShuffleOn}"
                                ToolTip.Tip="Aleatorio">
                                <Panel Width="36" Height="36">
                                    <PathIcon
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Data="M10.59 9.17L5.41 4 4 5.41l5.17 5.17 1.42-1.41zM14.5 4l2.04 2.04L4 18.59 5.41 20 17.96 7.46 20 9.5V4h-5.5zm.33 9.41l-1.41 1.41 3.13 3.13L14.5 20H20v-5.5l-2.04 2.04-3.13-3.13z" />
                                    <Ellipse
                                        Width="4"
                                        Height="4"
                                        Margin="0,0,0,3"
                                        VerticalAlignment="Bottom"
                                        Fill="{DynamicResource ThemeAccentBrush}"
                                        IsVisible="{Binding IsShuffleOn}" />
                                </Panel>
                            </ToggleButton>
                            <Button
                                AutomationProperties.Name="Anterior"
                                Classes="icon skip"
                                Command="{Binding PreviousCommand}"
                                ToolTip.Tip="Anterior">
                                <PathIcon Data="M6 6h2v12H6zm3.5 6l8.5 6V6z" />
                            </Button>
                            <Button
                                AutomationProperties.Name="{Binding PlayPauseText}"
                                Classes="play"
                                Command="{Binding TogglePlayPauseCommand}"
                                ToolTip.Tip="{Binding PlayPauseText}">
                                <Panel Classes="pp" Classes.playing="{Binding IsPlaying}">
                                    <PathIcon Classes="glyph-play" Data="M8 5v14l11-7z" />
                                    <PathIcon Classes="glyph-pause" Data="M6 19h4V5H6v14zm8-14v14h4V5h-4z" />
                                </Panel>
                            </Button>
                            <Button
                                AutomationProperties.Name="Siguiente"
                                Classes="icon skip"
                                Command="{Binding NextCommand}"
                                ToolTip.Tip="Siguiente">
                                <PathIcon Data="M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z" />
                            </Button>
                            <Button
                                AutomationProperties.Name="{Binding RepeatText}"
                                Classes="icon"
                                Classes.active="{Binding RepeatText, Converter={x:Static ObjectConverters.NotEqual}, ConverterParameter='Repetir: no'}"
                                Command="{Binding CycleRepeatCommand}"
                                ToolTip.Tip="{Binding RepeatText}">
                                <Panel Width="36" Height="36">
                                    <PathIcon
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Data="M7 7h10v3l4-4-4-4v3H5v6h2V7zm10 10H7v-3l-4 4 4 4v-3h12v-6h-2v4z" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="8"
                                        FontWeight="Bold"
                                        IsVisible="{Binding RepeatText, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='Repetir: una'}"
                                        Text="1" />
                                    <Ellipse
                                        Width="4"
                                        Height="4"
                                        Margin="0,0,0,3"
                                        VerticalAlignment="Bottom"
                                        Fill="{DynamicResource ThemeAccentBrush}"
                                        IsVisible="{Binding RepeatText, Converter={x:Static ObjectConverters.NotEqual}, ConverterParameter='Repetir: no'}" />
                                </Panel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                    <!--  Derecha: letras con la misma plantilla que el panel lateral  -->
                    <Panel Grid.Column="1" Margin="32,0,0,0">
                        <!--  Letra sincronizada: progresiva (docs/specs/lyrics-progressive.md)  -->
                        <controls:ProgressiveLyricsView
                            DimForeground="#59FFFFFF"
                            IsPlaying="{Binding IsPlaying}"
                            IsVisible="{Binding Lyrics.ShowProgressiveImmersive}"
                            Source="{Binding Lyrics}">
                            <controls:ProgressiveLyricsView.IsShown>
                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                    <Binding Path="IsImmersive" />
                                    <Binding Path="Lyrics.ShowProgressiveImmersive" />
                                </MultiBinding>
                            </controls:ProgressiveLyricsView.IsShown>
                        </controls:ProgressiveLyricsView>
                        <ListBox
                            Background="Transparent"
                            Classes="lyrics"
                            IsVisible="{Binding Lyrics.ShowClassicImmersive}"
                            ItemTemplate="{StaticResource LyricLineTemplate}"
                            ItemsSource="{Binding Lyrics.Lines}"
                            SelectedIndex="{Binding Lyrics.ActiveIndex, Mode=OneWay}"
                            Tapped="OnLyricTapped" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsVisible="{Binding !Lyrics.IsAvailable}"
                            Opacity="0.6"
                            Text="Sin letra disponible para esta canción" />
                    </Panel>
                </Grid>
            </Grid>
        </ThemeVariantScope>
    </Grid>
</Window>
