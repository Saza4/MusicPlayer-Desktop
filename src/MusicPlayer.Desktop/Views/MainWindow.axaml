<Window
    x:Class="MusicPlayer.Desktop.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MusicPlayer.Desktop.ViewModels"
    xmlns:controls="using:MusicPlayer.Desktop.Controls"
    xmlns:core="using:MusicPlayer.Core.Services"
    Title="Music Player"
    Width="960"
    Height="600"
    MinWidth="640"
    MinHeight="400"
    x:DataType="vm:MainViewModel"
    Background="{DynamicResource ThemeBackgroundBrush}"
    Icon="/Assets/app.ico">

    <Window.Resources>
        <DataTemplate x:Key="LyricLineTemplate" x:DataType="vm:LyricLineViewModel">
            <StackPanel
                Margin="8,6"
                Background="Transparent"
                Classes.active="{Binding IsActive}"
                Classes.synced="{Binding IsSynced}"
                Spacing="2">
                <TextBlock
                    Classes="lead"
                    FontSize="{Binding PronunciationFontSize}"
                    IsVisible="{Binding ShowPronunciation}"
                    Text="{Binding Pronunciation}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Classes="lead"
                    FontSize="{Binding OriginalFontSize}"
                    IsVisible="{Binding ShowOriginal}"
                    Text="{Binding Text}"
                    TextWrapping="Wrap" />
                <TextBlock
                    FontSize="{Binding TranslationFontSize}"
                    FontStyle="Italic"
                    IsVisible="{Binding ShowTranslation}"
                    Text="{Binding Translation}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </DataTemplate>
        <!--
            Panel lateral de letra (mockup 1a): tamaños fijos y compactos (15 el original, 12,5 la pronunciación y la
            traducción). «Pronunciación en texto grande» solo cambia el inmersivo.
        -->
        <DataTemplate x:Key="SideLyricLineTemplate" x:DataType="vm:LyricLineViewModel">
            <StackPanel
                Margin="0,7"
                Background="Transparent"
                Classes.active="{Binding IsActive}"
                Classes.synced="{Binding IsSynced}"
                Spacing="2">
                <TextBlock
                    Classes="secondary"
                    FontSize="12.5"
                    IsVisible="{Binding ShowPronunciation}"
                    Text="{Binding Pronunciation}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Classes="lead"
                    FontSize="15"
                    FontWeight="SemiBold"
                    IsVisible="{Binding ShowOriginal}"
                    LineHeight="20"
                    Text="{Binding Text}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Classes="secondary"
                    FontSize="12.5"
                    IsVisible="{Binding ShowTranslation}"
                    Text="{Binding Translation}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="Style Selector" />
        <!--  Preservado de estructura base  -->
        <!--  Diseño adaptable (docs/specs/responsive-layout.md): con la barra «narrow» el volumen pasa a un desplegable  -->
        <Style Selector="Border#PlayerBar.narrow Button.volume-wide">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Border#PlayerBar.narrow Slider.volume-wide">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Border#PlayerBar:not(.narrow) Button.volume-narrow">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="TextBlock.settings-title">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.6" />
        </Style>
        <Style Selector="TextBlock.settings-help">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.6" />
        </Style>
        <Style Selector="Grid.missing">
            <Setter Property="Opacity" Value="0.45" />
        </Style>
        <Style Selector="ListBox.lyrics ListBoxItem">
            <Setter Property="Padding" Value="0" />
        </Style>
        <!--  La línea activa se resalta con el TextBlock, no con la selección del ListBox  -->
        <Style Selector="ListBox.lyrics ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.lyrics ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.lyrics StackPanel.synced">
            <Setter Property="Opacity" Value="0.45" />
        </Style>
        <Style Selector="ListBox.lyrics StackPanel.synced.active">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="ListBox.lyrics StackPanel.active TextBlock.lead">
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <!--  Rediseño (docs/specs/redesign-mockups.md): textos secundarios, cabeceras y filas  -->
        <Style Selector="TextBlock.secondary">
            <Setter Property="Opacity" Value="0.7" />
        </Style>
        <Style Selector="TextBlock.section">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LetterSpacing" Value="0.8" />
            <Setter Property="Opacity" Value="0.6" />
        </Style>
        <Style Selector="TextBlock.heading">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <!--  Lista de canciones: filas de 52 px (carátula de 40 + 6 arriba y abajo), alineadas con la cabecera  -->
        <Style Selector="ListBox.songs">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <!--  El relleno va en el Border.row de la plantilla, para que la fila que suena se pinte entera  -->
        <Style Selector="ListBox.songs ListBoxItem, ListBox.album-tracks ListBoxItem">
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="ListBox.songs ListBoxItem /template/ ContentPresenter#PART_ContentPresenter, ListBox.album-tracks ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="Border.row">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="Border.row.playing">
            <Setter Property="Background" Value="{DynamicResource ThemeOverlaySelectedBrush}" />
        </Style>
        <!--  Si además está seleccionada, ya lleva el velo de la selección: no se suman dos  -->
        <Style Selector="ListBoxItem:selected Border.row.playing">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="TextBlock.track-title.playing">
            <Setter Property="Foreground" Value="{DynamicResource ThemePrimaryBrush}" />
        </Style>
        <Style Selector="ListBox.album-tracks">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <!--  Lista de álbumes (vista «Álbumes»)  -->
        <Style Selector="ListBox.browse-list">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="ListBox.browse-list ListBoxItem">
            <Setter Property="Padding" Value="12,6" />
        </Style>
        <Style Selector="ListBox.browse-list ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <!--  Barra lateral y lista de artistas: filas de 34 px con esquinas de 6  -->
        <Style Selector="ListBox.nav">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="ListBox.nav ListBoxItem">
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="ListBox.nav ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="TextBlock.nav-label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Opacity" Value="0.7" />
        </Style>
        <Style Selector="ListBox.nav ListBoxItem:selected TextBlock.nav-label">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>
        <Style Selector="ListBox.artists ListBoxItem:selected TextBlock.nav-label">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <!--  «Biblioteca» está en Playlists.Items, pero se elige en «Tu biblioteca»  -->
        <Style Selector="ListBox.playlists ListBoxItem">
            <Setter Property="IsVisible" Value="{ReflectionBinding IsUserPlaylist}" />
        </Style>
        <!--
            Columna de la barra lateral: al cambiar entre «Tu biblioteca» y la lista de artistas, el panel que aparece
            entra con un deslizamiento corto. ApplyLayout pone la clase solo al cambiar, no al redimensionar.
        -->
        <Style Selector="DockPanel.sidebar-panel.slide-in">
            <Style.Animations>
                <Animation Easing="CubicEaseOut" FillMode="Forward" Duration="0:0:0.18">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="TranslateTransform.X" Value="-16" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                        <Setter Property="TranslateTransform.X" Value="0" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <!--  Carátulas de la página de artista: la elegida lleva un velo suave y el título en el primario  -->
        <Style Selector="ListBox.cards">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="ListBox.cards ListBoxItem">
            <Setter Property="Padding" Value="8" />
            <Setter Property="Margin" Value="0,0,4,0" />
        </Style>
        <Style Selector="ListBox.cards ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style Selector="ListBox.cards ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ThemeOverlayHoverBrush}" />
        </Style>
        <Style Selector="ListBox.cards ListBoxItem:selected TextBlock.card-title">
            <Setter Property="Foreground" Value="{DynamicResource ThemePrimaryBrush}" />
        </Style>
        <!--  Panel de letra: la línea que suena va en el color primario (en el inmersivo sigue blanca)  -->
        <Style Selector="ListBox.lyrics.side StackPanel.active TextBlock.lead">
            <Setter Property="Foreground" Value="{DynamicResource ThemePrimaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="ListBox.lyrics.side StackPanel.synced">
            <Setter Property="Opacity" Value="0.6" />
        </Style>
        <Style Selector="ListBox.lyrics.side StackPanel.synced.active">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <!--  Configuración: cada grupo es una tarjeta con filas separadas por una línea  -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeOverlayBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style Selector="Border.card-row">
            <Setter Property="Padding" Value="16,14" />
        </Style>
        <Style Selector="Border.card-row.divided">
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeOverlayBorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <!--
            Barra superior (mockup 1a): el texto de las acciones también en el primario. Solo aquí: en Configuración
            los botones conservan su aspecto. Con un tema de usuario cuyo primario no se lea sobre el fondo, el texto
            perdería contraste (ThemeFactory no lo exige); el icono y el borde siguen identificando el botón.
        -->
        <Style Selector="Border#TopBar Button.action TextBlock.label">
            <Setter Property="Foreground" Value="{DynamicResource ThemePrimaryBrush}" />
        </Style>
        <!--
            Controles de la barra de reproducción (mockup 1a): más compactos que en el inmersivo y la isla, que
            conservan los suyos. Iconos de 17-18 px y Reproducir/Pausa de 42.
        -->
        <Style Selector="StackPanel.transport :is(Button).icon PathIcon">
            <Setter Property="Width" Value="17" />
            <Setter Property="Height" Value="17" />
        </Style>
        <Style Selector="StackPanel.transport :is(Button).icon.skip PathIcon">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
        </Style>
        <Style Selector="StackPanel.transport Button.play">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Margin" Value="4,0" />
        </Style>
        <Style Selector="StackPanel.transport Panel.pp PathIcon">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
        </Style>
        <!--  «Letra» abierta: además del color, un fondo suave (mockup 1a)  -->
        <Style Selector="Button.icon.toggled.active /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ThemeOverlayHoverBrush}" />
        </Style>
        <Style Selector="TextBlock.option-title">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>
    </Window.Styles>

    <Grid>
        <DockPanel>

            <!--  Barra superior  -->
            <!--  Con la ventana estrecha, la clase «compact» (MainWindow.axaml.cs) deja los botones de acción solo con icono  -->
            <!--
                Rediseño (docs/specs/redesign-mockups.md): la búsqueda a la izquierda y las acciones a la derecha, sobre el
                fondo de la ventana. La línea de estado pasó al pie de la zona central (StatusBar).
            -->
            <Border
                x:Name="TopBar"
                Padding="20,10,16,10"
                Background="{DynamicResource ThemeBackgroundBrush}"
                BorderBrush="{DynamicResource ThemeOverlayBorderBrush}"
                BorderThickness="0,0,0,1"
                DockPanel.Dock="Top">
                <DockPanel>
                    <!--  Solo con la ventana estrecha: muestra u oculta la barra lateral COLECCIONES  -->
                    <Button
                        x:Name="SidebarButton"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Colecciones"
                        Classes="action only"
                        Click="OnSidebarButtonClick"
                        DockPanel.Dock="Left"
                        IsVisible="False"
                        ToolTip.Tip="Mostrar u ocultar las colecciones">
                        <PathIcon Data="M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z" />
                    </Button>
                    <!--  Configuración: abre y cierra la vista que cubre la zona central (docs/specs/settings-panel.md)  -->
                    <Button
                        Margin="6,0,0,0"
                        AutomationProperties.Name="Configuración"
                        Classes="action square"
                        Command="{Binding Settings.ToggleOpenCommand}"
                        DockPanel.Dock="Right"
                        ToolTip.Tip="Configuración">
                        <StackPanel Orientation="Horizontal">
                            <PathIcon Data="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z" />
                        </StackPanel>
                    </Button>
                    <Button
                        Margin="6,0,0,0"
                        AutomationProperties.Name="Convertir lo que veo"
                        Classes="action"
                        Command="{Binding OpenConvertCommand}"
                        DockPanel.Dock="Right"
                        ToolTip.Tip="Convertir lo que veo">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="M18 12l4-4-4-4v3H3v2h15v3zM6 12l-4 4 4 4v-3h15v-2H6v-3z" />
                            <TextBlock Classes="label" Text="Convertir lo que veo…" />
                        </StackPanel>
                    </Button>
                    <!--  Autocompletar/Limpiar etiquetas… o editor de etiquetas  -->
                    <Button
                        Margin="6,0,0,0"
                        AutomationProperties.Name="Limpiar etiquetas"
                        Classes="action"
                        Command="{Binding OpenAutoFixCommand}"
                        DockPanel.Dock="Right"
                        ToolTip.Tip="Limpiar etiquetas">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="M21.41 11.58l-9-9C12.05 2.22 11.55 2 11 2H4c-1.1 0-2 .9-2 2v7c0 .55.22 1.05.59 1.42l9 9c.36.36.86.58 1.41.58.55 0 1.05-.22 1.41-.59l7-7c.37-.36.59-.86.59-1.41 0-.55-.23-1.06-.59-1.42zM5.5 7C4.67 7 4 6.33 4 5.5S4.67 4 5.5 4 7 4.67 7 5.5 6.33 7 5.5 7z" />
                            <TextBlock Classes="label" Text="Limpiar etiquetas" />
                        </StackPanel>
                    </Button>
                    <Button
                        Margin="16,0,0,0"
                        AutomationProperties.Name="Agregar carpeta"
                        Classes="action"
                        Command="{Binding AddFolderCommand}"
                        DockPanel.Dock="Right"
                        ToolTip.Tip="Agregar carpeta">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="M20 6h-8l-2-2H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm-1 8h-3v3h-2v-3h-3v-2h3V9h2v3h3v2z" />
                            <TextBlock Classes="label" Text="Agregar carpeta" />
                        </StackPanel>
                    </Button>
                    <!--
                        Ocupa lo que sobra hasta 360 px, pegada a la izquierda: con la ventana estrecha se encoge antes
                        que los botones. Lo que pase de 360 queda vacío a la derecha de la columna.
                    -->
                    <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MaxWidth="360" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        MinHeight="36"
                        VerticalContentAlignment="Center"
                        AutomationProperties.Name="Buscar"
                        CornerRadius="8"
                        Text="{Binding SearchText}"
                        Watermark="Buscar por título, artista o álbum">
                        <TextBox.InnerLeftContent>
                            <PathIcon
                                Width="14"
                                Height="14"
                                Margin="10,0,0,0"
                                Data="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"
                                Opacity="0.6" />
                        </TextBox.InnerLeftContent>
                    </TextBox>
                    </Grid>
                </DockPanel>
            </Border>

            <!--  Convertir formato  -->
            <Border
                Padding="16,12"
                Background="{DynamicResource ThemeSurfaceBrush}"
                DockPanel.Dock="Top"
                IsVisible="{Binding Conversion.IsOpen}">
                <ScrollViewer x:Name="ConvertScroll" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="8">
                    <TextBlock
                        FontWeight="SemiBold"
                        Text="{Binding Conversion.Heading}"
                        TextWrapping="Wrap" />

                    <TextBlock
                        Foreground="{DynamicResource ThemeDangerBrush}"
                        IsVisible="{Binding !Conversion.HasConverter}"
                        Text="No se encontró ffmpeg. Instálalo (en Windows: winget install Gyan.FFmpeg), reinicia la app y vuelve a intentarlo."
                        TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <StackPanel Spacing="2">
                            <TextBlock
                                FontSize="12"
                                Opacity="0.7"
                                Text="Formato" />
                            <ComboBox
                                MinWidth="110"
                                ItemsSource="{Binding Conversion.Formats}"
                                SelectedItem="{Binding Conversion.Format}" />
                        </StackPanel>
                        <StackPanel IsVisible="{Binding Conversion.UsesBitrate}" Spacing="2">
                            <TextBlock
                                FontSize="12"
                                Opacity="0.7"
                                Text="Calidad (kbps)" />
                            <ComboBox
                                MinWidth="110"
                                ItemsSource="{Binding Conversion.Bitrates}"
                                SelectedItem="{Binding Conversion.Bitrate}" />
                        </StackPanel>
                    </StackPanel>

                    <CheckBox Content="Agregar los archivos nuevos a la biblioteca" IsChecked="{Binding Conversion.AddToLibrary}" />
                    <TextBlock
                        FontSize="12"
                        Opacity="0.6"
                        Text="Los originales no se modifican: el resultado queda junto a ellos. Convertir de MP3 o M4A a FLAC o WAV no mejora la calidad."
                        TextWrapping="Wrap" />
                    <TextBlock IsVisible="{Binding Conversion.IsBusy}" Text="{Binding Conversion.ProgressText}" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Command="{Binding Conversion.StartCommand}" Content="Convertir" />
                        <Button Command="{Binding Conversion.CancelCommand}" Content="Cancelar" />
                    </StackPanel>
                </StackPanel>
                </ScrollViewer>
            </Border>

            <!--  Vista previa de sugerencias  -->
            <Border
                Padding="16,12"
                Background="{DynamicResource ThemeSurfaceBrush}"
                DockPanel.Dock="Top"
                IsVisible="{Binding AutoFix.IsOpen}">
                <ScrollViewer x:Name="AutoFixScroll" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="8">
                    <TextBlock
                        FontWeight="SemiBold"
                        Text="{Binding AutoFix.Heading}"
                        TextWrapping="Wrap" />
                    <CheckBox Content="Usar la carpeta como álbum si falta" IsChecked="{Binding AutoFix.AlbumFromFolder}" />

                    <ListBox MaxHeight="260" ItemsSource="{Binding AutoFix.Items}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:TagSuggestionItemViewModel">
                                <CheckBox Margin="4" IsChecked="{Binding IsSelected}">
                                    <StackPanel Spacing="2">
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Text="{Binding FileName}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            FontSize="12"
                                            Opacity="0.75"
                                            Text="{Binding ChangesText}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </CheckBox>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock
                        FontSize="12"
                        Opacity="0.6"
                        Text="Se escribe en los archivos. Si suena alguna de estas canciones, se notará un corte breve. Podrás deshacerlo después."
                        TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Command="{Binding AutoFix.ApplyCommand}" Content="{Binding AutoFix.ApplyText}" />
                        <Button Command="{Binding AutoFix.SelectAllCommand}" Content="Todas" />
                        <Button Command="{Binding AutoFix.SelectNoneCommand}" Content="Ninguna" />
                        <Button Command="{Binding AutoFix.CancelCommand}" Content="Cancelar" />
                    </StackPanel>
                </StackPanel>
                </ScrollViewer>
            </Border>

            <!--  Deshacer el último lote  -->
            <Border
                Padding="16,10"
                Background="{DynamicResource ThemeSuccessBarBrush}"
                DockPanel.Dock="Top"
                IsVisible="{Binding AutoFix.HasUndo}">
                <DockPanel>
                    <StackPanel
                        DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button Command="{Binding AutoFix.UndoCommand}" Content="Deshacer" />
                        <Button Command="{Binding AutoFix.DismissUndoCommand}" Content="Cerrar" />
                    </StackPanel>
                    <TextBlock
                        Margin="0,0,16,0"
                        VerticalAlignment="Center"
                        Text="{Binding AutoFix.UndoText}"
                        TextWrapping="Wrap" />
                </DockPanel>
            </Border>

            <!--  Barra de confirmación de eliminación  -->
            <Border
                Padding="16,10"
                Background="{DynamicResource ThemeDangerBarBrush}"
                DockPanel.Dock="Top"
                IsVisible="{Binding IsConfirmingDelete}">
                <DockPanel>
                    <StackPanel
                        DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button Command="{Binding ConfirmDeleteTrackCommand}" Content="Eliminar del disco" />
                        <Button Command="{Binding CancelDeleteTrackCommand}" Content="Cancelar" />
                    </StackPanel>
                    <TextBlock
                        Margin="0,0,16,0"
                        VerticalAlignment="Center"
                        Text="{Binding DeletePrompt}"
                        TextWrapping="Wrap" />
                </DockPanel>
            </Border>

            <!--  Barra de aviso  -->
            <Border
                Padding="16,10"
                Background="{DynamicResource ThemeWarningBarBrush}"
                DockPanel.Dock="Top"
                IsVisible="{Binding HasMissing}">
                <DockPanel>
                    <StackPanel
                        DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button
                            Command="{Binding CheckAvailabilityCommand}"
                            Content="Volver a revisar"
                            IsVisible="{Binding !IsConfirmingPrune}" />
                        <Button
                            Command="{Binding AskPruneCommand}"
                            Content="Quitar de la biblioteca…"
                            IsVisible="{Binding !IsConfirmingPrune}" />
                        <Button
                            Command="{Binding ConfirmPruneCommand}"
                            Content="Quitar"
                            IsVisible="{Binding IsConfirmingPrune}" />
                        <Button
                            Command="{Binding CancelPruneCommand}"
                            Content="Cancelar"
                            IsVisible="{Binding IsConfirmingPrune}" />
                    </StackPanel>
                    <TextBlock
                        Margin="0,0,16,0"
                        VerticalAlignment="Center"
                        Text="{Binding MissingPrompt}"
                        TextWrapping="Wrap" />
                </DockPanel>
            </Border>

            <Border
                Padding="16,12"
                Background="{DynamicResource ThemeSurfaceBrush}"
                DockPanel.Dock="Top"
                IsVisible="{Binding TagEditor.IsOpen}">
                <ScrollViewer x:Name="TagEditorScroll" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="8">
                    <TextBlock
                        FontWeight="SemiBold"
                        Text="{Binding TagEditor.Heading}"
                        TextTrimming="CharacterEllipsis" />
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
                        <StackPanel
                            Grid.Row="0"
                            Grid.Column="0"
                            Margin="0,0,8,8"
                            Spacing="2">
                            <TextBlock
                                FontSize="12"
                                Opacity="0.7"
                                Text="Título" />
                            <TextBox Text="{Binding TagEditor.Title}" />
                        </StackPanel>
                        <StackPanel
                            Grid.Row="0"
                            Grid.Column="1"
                            Margin="0,0,0,8"
                            Spacing="2">
                            <TextBlock
                                FontSize="12"
                                Opacity="0.7"
                                Text="Artista" />
                            <TextBox Text="{Binding TagEditor.Artist}" />
                        </StackPanel>
                        <StackPanel
                            Grid.Row="1"
                            Grid.Column="0"
                            Margin="0,0,8,0"
                            Spacing="2">
                            <TextBlock
                                FontSize="12"
                                Opacity="0.7"
                                Text="Álbum" />
                            <TextBox Text="{Binding TagEditor.Album}" />
                        </StackPanel>
                        <StackPanel
                            Grid.Row="1"
                            Grid.Column="1"
                            Spacing="2">
                            <TextBlock
                                FontSize="12"
                                Opacity="0.7"
                                Text="Artista del álbum" />
                            <TextBox Text="{Binding TagEditor.AlbumArtist}" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border
                            Width="96"
                            Height="96"
                            Background="{DynamicResource ThemeOverlayCoverBrush}"
                            ClipToBounds="True"
                            CornerRadius="6">
                            <Panel>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="36"
                                    Opacity="0.4"
                                    Text="♪" />
                                <Image Source="{Binding TagEditor.CoverPreview}" Stretch="UniformToFill" />
                            </Panel>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="6">
                            <TextBlock
                                FontSize="12"
                                Opacity="0.7"
                                Text="Carátula (JPG o PNG)" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Command="{Binding TagEditor.ChooseCoverCommand}" Content="Elegir imagen…" />
                                <Button Command="{Binding TagEditor.RemoveCoverCommand}" Content="Quitar" />
                            </StackPanel>
                            <TextBlock
                                FontSize="12"
                                Opacity="0.6"
                                Text="{Binding TagEditor.CoverNote}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <StackPanel Spacing="2">
                            <TextBlock
                                FontSize="12"
                                Opacity="0.7"
                                Text="Año" />
                            <TextBox Width="90" Text="{Binding TagEditor.YearText}" />
                        </StackPanel>
                        <StackPanel Spacing="2">
                            <TextBlock
                                FontSize="12"
                                Opacity="0.7"
                                Text="Pista" />
                            <TextBox Width="90" Text="{Binding TagEditor.TrackText}" />
                        </StackPanel>
                        <StackPanel Spacing="2">
                            <TextBlock
                                FontSize="12"
                                Opacity="0.7"
                                Text="Disco" />
                            <TextBox Width="90" Text="{Binding TagEditor.DiscText}" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock
                        Foreground="{DynamicResource ThemeDangerBrush}"
                        IsVisible="{Binding TagEditor.HasError}"
                        Text="{Binding TagEditor.Error}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        FontSize="12"
                        Opacity="0.6"
                        Text="Se escribe en el archivo. Si esta canción suena, se notará un corte breve. Un campo vacío borra la etiqueta."
                        TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Command="{Binding TagEditor.SaveCommand}" Content="Guardar" />
                        <Button Command="{Binding TagEditor.CancelCommand}" Content="Cancelar" />
                    </StackPanel>
                </StackPanel>
                </ScrollViewer>
            </Border>

            <!--  Controles de reproducción: [carátula + título] [controles + progreso] [letra, pantalla completa, volumen]  -->
            <Border
                x:Name="PlayerBar"
                Height="88"
                Padding="20,0"
                Background="{DynamicResource ThemeSurfaceBrush}"
                BorderBrush="{DynamicResource ThemeOverlayBorderBrush}"
                BorderThickness="0,1,0,0"
                DockPanel.Dock="Bottom">
                <!--  Barras finas con pulgar de 12 px (mockup 1a); solo aquí, el inmersivo y la isla no cambian  -->
                <Border.Resources>
                    <x:Double x:Key="SliderHorizontalThumbWidth">12</x:Double>
                    <x:Double x:Key="SliderHorizontalThumbHeight">12</x:Double>
                    <CornerRadius x:Key="SliderThumbCornerRadius">6</CornerRadius>
                </Border.Resources>
                <!--
                    Columna central de ancho fijo entre dos laterales iguales: los controles quedan centrados en la
                    ventana a cualquier ancho. El ancho lo fija ApplyLayout (LayoutBreakpoints.PlayerCenterWidth).
                -->
                <Grid x:Name="PlayerGrid" ColumnDefinitions="*,560,*">

                    <!--  Izquierda: carátula, título y artista  -->
                    <Grid
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        ColumnDefinitions="Auto,*">
                        <Button
                            Width="52"
                            Height="52"
                            Padding="0"
                            AutomationProperties.Name="Pantalla completa"
                            ClipToBounds="True"
                            Command="{Binding OpenImmersiveCommand}"
                            CornerRadius="6"
                            ToolTip.Tip="Pantalla completa">
                            <Panel>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="22"
                                    Opacity="0.5"
                                    Text="♪" />
                                <Image Source="{Binding NowPlayingCover}" Stretch="UniformToFill" />
                            </Panel>
                        </Button>
                        <StackPanel
                            Grid.Column="1"
                            Margin="12,0,12,0"
                            VerticalAlignment="Center"
                            Spacing="3">
                            <TextBlock
                                FontSize="14"
                                FontWeight="SemiBold"
                                Text="{Binding CurrentTrack.Title}"
                                TextTrimming="CharacterEllipsis"
                                IsVisible="{Binding CurrentTrack, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            <TextBlock
                                Classes="secondary"
                                FontSize="12.5"
                                Text="{Binding CurrentTrack.Artist}"
                                TextTrimming="CharacterEllipsis"
                                IsVisible="{Binding CurrentTrack, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            <!--  Sin canción: el texto de siempre («Nada en reproducción»)  -->
                            <TextBlock
                                Classes="secondary"
                                Text="{Binding NowPlaying}"
                                TextTrimming="CharacterEllipsis"
                                IsVisible="{Binding CurrentTrack, Converter={x:Static ObjectConverters.IsNull}}" />
                        </StackPanel>
                    </Grid>

                    <!--  Centro: Aleatorio · Anterior · Reproducir/Pausa · Siguiente · Repetir, y debajo el progreso  -->
                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Classes="transport"
                        Spacing="4">
                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="6">
                            <ToggleButton
                                AutomationProperties.Name="Aleatorio"
                                Classes="icon"
                                Classes.active="{Binding IsShuffleOn}"
                                IsChecked="{Binding IsShuffleOn}"
                                ToolTip.Tip="Aleatorio">
                                <Panel Width="36" Height="36">
                                    <PathIcon
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Data="M10.59 9.17L5.41 4 4 5.41l5.17 5.17 1.42-1.41zM14.5 4l2.04 2.04L4 18.59 5.41 20 17.96 7.46 20 9.5V4h-5.5zm.33 9.41l-1.41 1.41 3.13 3.13L14.5 20H20v-5.5l-2.04 2.04-3.13-3.13z" />
                                    <Ellipse
                                        Width="4"
                                        Height="4"
                                        Margin="0,0,0,3"
                                        VerticalAlignment="Bottom"
                                        Fill="{DynamicResource ThemeAccentBrush}"
                                        IsVisible="{Binding IsShuffleOn}" />
                                </Panel>
                            </ToggleButton>
                            <Button
                                AutomationProperties.Name="Anterior"
                                Classes="icon skip"
                                Command="{Binding PreviousCommand}"
                                ToolTip.Tip="Anterior">
                                <PathIcon Data="M6 6h2v12H6zm3.5 6l8.5 6V6z" />
                            </Button>
                            <Button
                                AutomationProperties.Name="{Binding PlayPauseText}"
                                Classes="play"
                                Command="{Binding TogglePlayPauseCommand}"
                                ToolTip.Tip="{Binding PlayPauseText}">
                                <Panel Classes="pp" Classes.playing="{Binding IsPlaying}">
                                    <PathIcon Classes="glyph-play" Data="M8 5v14l11-7z" />
                                    <PathIcon Classes="glyph-pause" Data="M6 19h4V5H6v14zm8-14v14h4V5h-4z" />
                                </Panel>
                            </Button>
                            <Button
                                AutomationProperties.Name="Siguiente"
                                Classes="icon skip"
                                Command="{Binding NextCommand}"
                                ToolTip.Tip="Siguiente">
                                <PathIcon Data="M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z" />
                            </Button>
                            <Button
                                AutomationProperties.Name="{Binding RepeatText}"
                                Classes="icon"
                                Classes.active="{Binding RepeatText, Converter={x:Static ObjectConverters.NotEqual}, ConverterParameter='Repetir: no'}"
                                Command="{Binding CycleRepeatCommand}"
                                ToolTip.Tip="{Binding RepeatText}">
                                <Panel Width="36" Height="36">
                                    <PathIcon
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Data="M7 7h10v3l4-4-4-4v3H5v6h2V7zm10 10H7v-3l-4 4 4 4v-3h12v-6h-2v4z" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="8"
                                        FontWeight="Bold"
                                        IsVisible="{Binding RepeatText, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='Repetir: una'}"
                                        Text="1" />
                                    <Ellipse
                                        Width="4"
                                        Height="4"
                                        Margin="0,0,0,3"
                                        VerticalAlignment="Bottom"
                                        Fill="{DynamicResource ThemeAccentBrush}"
                                        IsVisible="{Binding RepeatText, Converter={x:Static ObjectConverters.NotEqual}, ConverterParameter='Repetir: no'}" />
                                </Panel>
                            </Button>
                        </StackPanel>
                        <Grid MaxWidth="520" ColumnDefinitions="44,*,44">
                            <TextBlock
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Classes="secondary"
                                FontSize="11.5"
                                Text="{Binding PositionText}" />
                            <Slider
                                Grid.Column="1"
                                Classes="progress"
                                Maximum="{Binding DurationSeconds}"
                                Minimum="0"
                                Value="{Binding PositionSeconds}" />
                            <TextBlock
                                Grid.Column="2"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Classes="secondary"
                                FontSize="11.5"
                                Text="{Binding DurationText}" />
                        </Grid>
                    </StackPanel>

                    <!--  Derecha: Letra, Pantalla completa, Isla flotante y Volumen  -->
                    <StackPanel
                        Grid.Column="2"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="4">
                        <Button
                            AutomationProperties.Name="Letra"
                            Classes="icon toggled"
                            Classes.active="{Binding Lyrics.ShowPanel}"
                            Command="{Binding Lyrics.ToggleOpenCommand}"
                            IsEnabled="{Binding Lyrics.IsAvailable}"
                            ToolTip.Tip="Letra">
                            <PathIcon Data="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zM4 12h4v2H4v-2zm10 6H4v-2h10v2zm6 0h-4v-2h4v2zm0-4H10v-2h10v2z" />
                        </Button>
                        <!--
                            Isla flotante (solo Windows). Button con comando y no ToggleButton, para no pelear con el
                            atajo global de Espacio. Acento cuando está activada; el texto dice lo que hará el clic.
                        -->
                        <Button
                            AutomationProperties.Name="{Binding IslandToggleText}"
                            Classes="icon"
                            Classes.active="{Binding ShowIsland}"
                            Command="{Binding ToggleIslandCommand}"
                            IsVisible="{Binding IsIslandSupported}"
                            ToolTip.Tip="{Binding IslandToggleText}">
                            <PathIcon Data="M2 4h20v16H2V4zm2 2v12h16V6H4zm4 1h8a1.5 1.5 0 0 1 0 3H8a1.5 1.5 0 0 1 0-3z" />
                        </Button>
                        <Button
                            AutomationProperties.Name="Pantalla completa"
                            Classes="icon"
                            Command="{Binding OpenImmersiveCommand}"
                            ToolTip.Tip="Pantalla completa">
                            <PathIcon Data="M7 14H5v5h5v-2H7v-3zm-2-4h2V7h3V5H5v5zm12 7h-3v2h5v-5h-2v3zM14 5v2h3v3h2V5h-5z" />
                        </Button>
                        <Button
                            Margin="8,0,0,0"
                            AutomationProperties.Name="{Binding MuteText}"
                            Classes="icon volume-wide"
                            Command="{Binding ToggleMuteCommand}"
                            PointerWheelChanged="OnVolumeWheel"
                            ToolTip.Tip="{Binding MuteText, StringFormat='{}{0} (M)'}">
                            <Panel>
                                <PathIcon Data="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z" IsVisible="{Binding !IsMuted}" />
                                <PathIcon Data="M16.5 12c0-1.77-1.02-3.29-2.5-4.03v2.21l2.45 2.45c.03-.2.05-.41.05-.63zm2.5 0c0 .94-.2 1.82-.54 2.64l1.51 1.51C20.63 14.91 21 13.5 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3L3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06c1.38-.31 2.63-.95 3.69-1.81L19.73 21 21 19.73l-9-9L4.27 3zM12 4L9.91 6.09 12 8.18V4z" IsVisible="{Binding IsMuted}" />
                            </Panel>
                        </Button>
                        <Slider
                            Width="92"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Volumen"
                            Classes="volume-wide"
                            Maximum="1"
                            Minimum="0"
                            Value="{Binding Volume}" />
                        <!--
                            Ventana estrecha: el deslizador no cabe y pasa a este desplegable, con el silencio dentro.
                            La rueda sobre el botón cambia el volumen sin abrirlo.
                        -->
                        <Button
                            x:Name="VolumeButton"
                            Margin="8,0,0,0"
                            AutomationProperties.Name="Volumen"
                            Classes="icon volume-narrow"
                            PointerWheelChanged="OnVolumeWheel"
                            ToolTip.Tip="Volumen">
                            <Panel>
                                <PathIcon Data="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z" IsVisible="{Binding !IsMuted}" />
                                <PathIcon Data="M16.5 12c0-1.77-1.02-3.29-2.5-4.03v2.21l2.45 2.45c.03-.2.05-.41.05-.63zm2.5 0c0 .94-.2 1.82-.54 2.64l1.51 1.51C20.63 14.91 21 13.5 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3L3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06c1.38-.31 2.63-.95 3.69-1.81L19.73 21 21 19.73l-9-9L4.27 3zM12 4L9.91 6.09 12 8.18V4z" IsVisible="{Binding IsMuted}" />
                            </Panel>
                            <Button.Flyout>
                                <Flyout Opened="OnVolumeFlyoutOpened" Placement="TopEdgeAlignedRight">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button
                                            AutomationProperties.Name="{Binding MuteText}"
                                            Classes="icon"
                                            Command="{Binding ToggleMuteCommand}"
                                            ToolTip.Tip="{Binding MuteText}">
                                            <Panel>
                                                <PathIcon Data="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02z" IsVisible="{Binding !IsMuted}" />
                                                <PathIcon Data="M16.5 12c0-1.77-1.02-3.29-2.5-4.03v2.21l2.45 2.45c.03-.2.05-.41.05-.63zM4.27 3L3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25 1.27-1.27-9-9L4.27 3zM12 4L9.91 6.09 12 8.18V4z" IsVisible="{Binding IsMuted}" />
                                            </Panel>
                                        </Button>
                                        <Slider
                                            x:Name="VolumeFlyoutSlider"
                                            Width="160"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="Volumen"
                                            Maximum="1"
                                            Minimum="0"
                                            Value="{Binding Volume}" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!--  Barra lateral, Lista de canciones y Panel de letras  -->
            <!--
                Fila 0: barra lateral, lista y letra. Fila 1: la línea de estado, bajo la lista y la letra.
            -->
            <Grid
                x:Name="CentralGrid"
                ColumnDefinitions="232,*,Auto"
                RowDefinitions="*,Auto">
                <!--
                    Columna 0: la barra lateral (Sidebar) o, en Artistas, la lista de artistas (ArtistSidebar), en el
                    mismo sitio, con el mismo ancho y fondo. Cuál se ve, y si la columna se ve, lo decide ApplyLayout.
                -->
                <Border
                    x:Name="SidebarBackground"
                    Grid.RowSpan="2"
                    Grid.Column="0"
                    Background="{DynamicResource ThemeSurfaceBrush}"
                    BorderBrush="{DynamicResource ThemeOverlayBorderBrush}"
                    BorderThickness="0,0,1,0" />
                <DockPanel
                    x:Name="ArtistSidebar"
                    Grid.RowSpan="2"
                    Grid.Column="0"
                    Margin="12,18,12,12"
                    Classes="sidebar-panel"
                    IsVisible="False">
                    <DockPanel.RenderTransform>
                        <TranslateTransform />
                    </DockPanel.RenderTransform>
                    <DockPanel Margin="0,0,0,8" DockPanel.Dock="Top">
                        <!--  Vuelve a «Tu biblioteca» + «Playlists» sin salir de la página de artista (también Esc)  -->
                        <Button
                            Margin="0,0,6,0"
                            AutomationProperties.Name="Volver a la biblioteca"
                            Classes="action only"
                            Command="{Binding ShowLibraryNavCommand}"
                            DockPanel.Dock="Left"
                            ToolTip.Tip="Volver a la biblioteca (Esc)">
                            <PathIcon Data="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z" />
                        </Button>
                        <TextBlock
                            VerticalAlignment="Center"
                            Classes="section"
                            Text="ARTISTAS DEL ÁLBUM" />
                    </DockPanel>
                    <ListBox
                        x:Name="ArtistList"
                        Classes="nav artists"
                        ItemsSource="{Binding Artists}"
                        SelectedItem="{Binding SelectedArtist}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:ArtistItemViewModel">
                                <DockPanel VerticalAlignment="Center">
                                    <TextBlock
                                        Margin="8,0,0,0"
                                        DockPanel.Dock="Right"
                                        FontSize="12"
                                        Opacity="0.5"
                                        Text="{Binding CountText}" />
                                    <TextBlock
                                        Classes="nav-label artist-name"
                                        Text="{Binding Name}"
                                        TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
                <DockPanel
                    x:Name="Sidebar"
                    Grid.RowSpan="2"
                    Grid.Column="0"
                    Margin="12,18,12,12"
                    Classes="sidebar-panel">
                    <DockPanel.RenderTransform>
                        <TranslateTransform />
                    </DockPanel.RenderTransform>
                    <!--  Panel de edición (crear / renombrar / confirmar eliminación)  -->
                    <Border
                        Margin="0,8,0,0"
                        Padding="8"
                        Background="{DynamicResource ThemeSurfaceBrush}"
                        CornerRadius="8"
                        DockPanel.Dock="Bottom"
                        IsVisible="{Binding Playlists.IsEditing}">
                        <StackPanel Spacing="6">
                            <TextBlock
                                FontWeight="SemiBold"
                                Text="{Binding Playlists.Prompt}"
                                TextWrapping="Wrap" />
                            <TextBox
                                x:Name="PlaylistNameBox"
                                IsVisible="{Binding Playlists.IsNameInput}"
                                KeyDown="OnPlaylistNameKeyDown"
                                MaxLength="80"
                                Text="{Binding Playlists.NameDraft}"
                                Watermark="Nombre" />
                            <TextBlock
                                Foreground="{DynamicResource ThemeDangerBrush}"
                                IsVisible="{Binding Playlists.HasEditError}"
                                Text="{Binding Playlists.EditError}"
                                TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Command="{Binding Playlists.ConfirmEditCommand}" Content="{Binding Playlists.ConfirmText}" />
                                <Button Command="{Binding Playlists.CancelEditCommand}" Content="Cancelar" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <!--  Renombrar / eliminar: solo con una playlist seleccionada  -->
                    <StackPanel
                        Margin="0,8,0,0"
                        DockPanel.Dock="Bottom"
                        IsVisible="{Binding Playlists.HasPlaylistSelected}"
                        Orientation="Horizontal"
                        Spacing="6">
                        <Button Command="{Binding Playlists.BeginRenameCommand}" Content="Renombrar" />
                        <Button Command="{Binding Playlists.BeginDeleteCommand}" Content="Eliminar" />
                    </StackPanel>
                    <!--
                        «Tu biblioteca» (mockup 1a): las vistas de la biblioteca. Elegir una vuelve a la biblioteca si
                        había una playlist abierta (LibraryNavIndex).
                    -->
                    <TextBlock
                        Margin="10,0,0,8"
                        Classes="section"
                        DockPanel.Dock="Top"
                        Text="Tu biblioteca" />
                    <ListBox
                        x:Name="LibraryNav"
                        Classes="nav"
                        DockPanel.Dock="Top"
                        SelectedIndex="{Binding LibraryNavIndex, Mode=TwoWay}">
                        <ListBoxItem AutomationProperties.Name="Canciones">
                            <DockPanel>
                                <TextBlock
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Classes="secondary"
                                    DockPanel.Dock="Right"
                                    FontSize="12"
                                    Text="{Binding LibraryCountText}" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Classes="nav-label"
                                    Text="Canciones" />
                            </DockPanel>
                        </ListBoxItem>
                        <!--
                            «Álbumes» oculto por ahora (el mockup 1a no lo tiene). La vista sigue en el código; para
                            recuperarla, descomentar esto y su entrada en MainViewModel.NavModes.
                        <ListBoxItem AutomationProperties.Name="Álbumes">
                            <TextBlock Classes="nav-label" Text="Álbumes" />
                        </ListBoxItem>
                        -->
                        <!--  Ya elegido, el clic trae de vuelta la lista de artistas si se había ocultado con ←  -->
                        <ListBoxItem AutomationProperties.Name="Artistas" Tapped="OnArtistsNavTapped">
                            <TextBlock Classes="nav-label" Text="Artistas" />
                        </ListBoxItem>
                    </ListBox>
                    <DockPanel Margin="10,22,4,6" DockPanel.Dock="Top">
                        <Button
                            AutomationProperties.Name="Nueva playlist"
                            Classes="action only"
                            Command="{Binding Playlists.BeginCreateCommand}"
                            DockPanel.Dock="Right"
                            ToolTip.Tip="Nueva playlist">
                            <PathIcon Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" />
                        </Button>
                        <TextBlock
                            VerticalAlignment="Center"
                            Classes="section"
                            Text="Playlists" />
                    </DockPanel>
                    <!--  La entrada «Biblioteca» de Playlists.Items se oculta: la biblioteca se elige arriba  -->
                    <ListBox
                        Classes="nav playlists"
                        ItemsSource="{Binding Playlists.Items}"
                        SelectedItem="{Binding Playlists.Selected}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:PlaylistItemViewModel">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Classes="nav-label"
                                    Text="{Binding Name}"
                                    TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <DockPanel
                    x:Name="ListArea"
                    Grid.Column="1"
                    Margin="16,18,16,0">
                    <DockPanel
                        Margin="12,0,0,8"
                        DockPanel.Dock="Top"
                        IsVisible="{Binding ShowBackBar}">
                        <Button
                            Command="{Binding GoBackCommand}"
                            Content="{Binding BackText}"
                            DockPanel.Dock="Left" />
                        <Button
                            HorizontalAlignment="Right"
                            Command="{Binding PlayScopeCommand}"
                            Content="▶ Reproducir" />
                    </DockPanel>
                    <!--  Cabecera: título de lo que se ve («Canciones», la playlist, el álbum…) y su resumen  -->
                    <StackPanel
                        Margin="12,4,0,14"
                        DockPanel.Dock="Top"
                        IsVisible="{Binding ShowListHeader}"
                        Orientation="Horizontal"
                        Spacing="12">
                        <TextBlock
                            VerticalAlignment="Bottom"
                            Classes="heading"
                            Text="{Binding ListHeading}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Margin="0,0,0,4"
                            VerticalAlignment="Bottom"
                            Classes="secondary"
                            FontSize="13"
                            Text="{Binding ListSummary}" />
                    </StackPanel>
                    <!--  Columnas de la lista de canciones: mismas medidas que la fila (relleno de 12 del ListBoxItem)  -->
                    <Border
                        Height="30"
                        Padding="12,0"
                        BorderBrush="{DynamicResource ThemeOverlayBorderBrush}"
                        BorderThickness="0,0,0,1"
                        DockPanel.Dock="Top"
                        IsVisible="{Binding ShowSongs}">
                        <Grid VerticalAlignment="Center" ColumnDefinitions="40,2*,1.2*,1.2*,64">
                            <TextBlock Classes="section" Text="#" />
                            <TextBlock
                                Grid.Column="1"
                                Classes="section"
                                Text="TÍTULO" />
                            <TextBlock
                                Grid.Column="2"
                                Margin="12,0,0,0"
                                Classes="section"
                                Text="ARTISTA" />
                            <TextBlock
                                Grid.Column="3"
                                Margin="12,0,0,0"
                                Classes="section"
                                Text="ÁLBUM" />
                            <TextBlock
                                Grid.Column="4"
                                HorizontalAlignment="Right"
                                Classes="section"
                                Text="DURACIÓN" />
                        </Grid>
                    </Border>
                    <Panel Margin="0,4,0,0">
                        <!--  Canciones: el mismo ListBox de antes, con columnas y la carátula junto al título  -->
                        <ListBox
                            x:Name="SongList"
                            Classes="songs"
                            ContextRequested="OnTrackListContextRequested"
                            DoubleTapped="OnTrackDoubleTapped"
                            Tapped="OnTrackTapped"
                            IsVisible="{Binding ShowSongs}"
                            ItemsSource="{Binding Tracks}"
                            SelectedItem="{Binding SelectedTrack}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:TrackItemViewModel">
                                    <!--  La fila que suena lleva el velo de selección, como en el mockup  -->
                                    <Border Classes="row" Classes.playing="{Binding IsPlaying}">
                                    <Grid Classes.missing="{Binding !IsAvailable}" ColumnDefinitions="40,2*,1.2*,1.2*,64">
                                        <!--  «#»: número de la fila, o tres barras si es la que suena  -->
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Classes="secondary"
                                            FontSize="13"
                                            IsVisible="{Binding IsNotPlaying}"
                                            Text="{Binding Number}" />
                                        <StackPanel
                                            Height="12"
                                            VerticalAlignment="Center"
                                            IsVisible="{Binding IsPlaying}"
                                            Orientation="Horizontal"
                                            Spacing="2"
                                            ToolTip.Tip="Suena ahora">
                                            <Rectangle
                                                Width="3"
                                                Height="7"
                                                VerticalAlignment="Bottom"
                                                Fill="{DynamicResource ThemePrimaryBrush}"
                                                RadiusX="1"
                                                RadiusY="1" />
                                            <Rectangle
                                                Width="3"
                                                Height="12"
                                                VerticalAlignment="Bottom"
                                                Fill="{DynamicResource ThemePrimaryBrush}"
                                                RadiusX="1"
                                                RadiusY="1" />
                                            <Rectangle
                                                Width="3"
                                                Height="5"
                                                VerticalAlignment="Bottom"
                                                Fill="{DynamicResource ThemePrimaryBrush}"
                                                RadiusX="1"
                                                RadiusY="1" />
                                        </StackPanel>
                                        <!--  Título con la carátula del álbum a su izquierda  -->
                                        <DockPanel Grid.Column="1">
                                            <Border
                                                Width="40"
                                                Height="40"
                                                Margin="0,0,12,0"
                                                Background="{DynamicResource ThemeOverlayCoverBrush}"
                                                ClipToBounds="True"
                                                CornerRadius="4"
                                                DockPanel.Dock="Left">
                                                <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                                            </Border>
                                            <Border
                                                Margin="8,0,0,0"
                                                Padding="6,2"
                                                VerticalAlignment="Center"
                                                BorderBrush="{DynamicResource ThemeOverlayBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                DockPanel.Dock="Right"
                                                IsVisible="{Binding !IsAvailable}">
                                                <TextBlock
                                                    FontSize="10.5"
                                                    FontWeight="SemiBold"
                                                    Text="No disponible" />
                                            </Border>
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Classes="track-title"
                                                Classes.playing="{Binding IsPlaying}"
                                                FontSize="13"
                                                FontWeight="Medium"
                                                Text="{Binding Title}"
                                                TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                        <TextBlock
                                            Grid.Column="2"
                                            Margin="12,0,0,0"
                                            VerticalAlignment="Center"
                                            Classes="secondary"
                                            FontSize="13"
                                            Text="{Binding Artist}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Grid.Column="3"
                                            Margin="12,0,0,0"
                                            VerticalAlignment="Center"
                                            Classes="secondary"
                                            FontSize="13"
                                            Text="{Binding Album}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Grid.Column="4"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Classes="secondary"
                                            FontSize="13"
                                            Text="{Binding DurationText}" />
                                    </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <ListBox
                            Classes="browse-list"
                            IsVisible="{Binding ShowAlbums}"
                            ItemsSource="{Binding Albums}"
                            Tapped="OnBrowseTapped">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:AlbumItemViewModel">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <!--  Thumbnail de Álbumes  -->
                                        <Border
                                            Width="56"
                                            Height="56"
                                            Margin="0,0,12,0"
                                            Background="{DynamicResource ThemeOverlayCoverBrush}"
                                            ClipToBounds="True"
                                            CornerRadius="4">
                                            <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                                        </Border>
                                        <StackPanel
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Spacing="2">
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                Text="{Binding Title}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Opacity="0.7"
                                                Text="{Binding Subtitle}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Panel>
                </DockPanel>

                <!--
                    Página de artista (mockup 1c): migas, nombre, carátulas de sus álbumes y las pistas del álbum
                    elegido. La lista de artistas va en la columna de la barra lateral (ArtistSidebar). La página va en
                    la misma columna que la lista: con la ventana estrecha y la letra abierta, ApplyLayout deja esa
                    columna en 0 y la página se va con ella.
                -->
                <Panel
                    x:Name="ArtistPage"
                    Grid.Column="1"
                    IsVisible="{Binding ShowArtistPage}">
                    <DockPanel Margin="32,22,32,0">
                        <!--  Migas y nombre  -->
                        <StackPanel
                            Margin="0,0,0,24"
                            DockPanel.Dock="Top"
                            Spacing="6">
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="8"
                                TextElement.FontSize="12.5">
                                <TextBlock Foreground="{DynamicResource ThemePrimaryBrush}" Text="Artistas" />
                                <TextBlock Classes="secondary" Text="›" />
                                <TextBlock
                                    Classes="secondary"
                                    Text="{Binding SelectedArtist.Name}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock
                                    VerticalAlignment="Bottom"
                                    FontSize="28"
                                    FontWeight="Bold"
                                    Text="{Binding SelectedArtist.Name}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Margin="0,0,0,5"
                                    VerticalAlignment="Bottom"
                                    Classes="secondary"
                                    FontSize="13"
                                    Text="{Binding ArtistPageSummary}" />
                            </StackPanel>
                        </StackPanel>

                        <!--  Carátulas de los álbumes: elegir una muestra sus pistas debajo  -->
                        <!--  Una sola fila, como en el mockup: con muchos álbumes se desplaza a lo ancho  -->
                        <ListBox
                            Margin="-8,0,0,24"
                            Classes="cards"
                            DockPanel.Dock="Top"
                            ItemsSource="{Binding Albums}"
                            ScrollViewer.HorizontalScrollBarVisibility="Auto"
                            ScrollViewer.VerticalScrollBarVisibility="Disabled"
                            SelectedItem="{Binding SelectedAlbum}">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:AlbumItemViewModel">
                                    <!--  Medida compartida con la prueba de CoverSizes (se decodifica a 512 px)  -->
                                    <StackPanel Width="{x:Static core:CoverSizes.CardDisplaySize}" Spacing="8">
                                        <Border
                                            Width="{x:Static core:CoverSizes.CardDisplaySize}"
                                            Height="{x:Static core:CoverSizes.CardDisplaySize}"
                                            Background="{DynamicResource ThemeOverlayCoverBrush}"
                                            ClipToBounds="True"
                                            CornerRadius="8">
                                            <Panel>
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="40"
                                                    Opacity="0.4"
                                                    Text="♪" />
                                                <!--  CardCover: 512 px, no la miniatura de 96; el ♪ se ve mientras carga  -->
                                                <Image
                                                    RenderOptions.BitmapInterpolationMode="HighQuality"
                                                    Source="{Binding CardCover}"
                                                    Stretch="UniformToFill" />
                                            </Panel>
                                        </Border>
                                        <StackPanel Spacing="2">
                                            <TextBlock
                                                Classes="card-title"
                                                FontSize="13.5"
                                                FontWeight="SemiBold"
                                                Text="{Binding Title}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Classes="secondary"
                                                FontSize="12"
                                                Text="{Binding CardSubtitle}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!--  Álbum elegido: «Shiokaze · 2024» y «DISCO 1»  -->
                        <Border
                            Margin="0,0,0,4"
                            Padding="12,0,12,8"
                            BorderBrush="{DynamicResource ThemeOverlayBorderBrush}"
                            BorderThickness="0,0,0,1"
                            DockPanel.Dock="Top">
                            <DockPanel>
                                <TextBlock
                                    VerticalAlignment="Bottom"
                                    Classes="section"
                                    DockPanel.Dock="Right"
                                    Text="{Binding AlbumSectionDisc}" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock
                                        FontSize="15"
                                        FontWeight="SemiBold"
                                        Text="{Binding AlbumSectionTitle}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Classes="secondary"
                                        FontSize="15"
                                        Text="{Binding AlbumSectionYear}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!--  Pistas del álbum: mismos clics, menú y atajos que la lista de canciones  -->
                        <ListBox
                            Classes="album-tracks"
                            ContextRequested="OnTrackListContextRequested"
                            DoubleTapped="OnTrackDoubleTapped"
                            ItemsSource="{Binding Tracks}"
                            SelectedItem="{Binding SelectedTrack}"
                            Tapped="OnTrackTapped">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:TrackItemViewModel">
                                    <StackPanel>
                                        <TextBlock
                                            Margin="12,14,0,6"
                                            Classes="section"
                                            IsVisible="{Binding HasDiscHeader}"
                                            Text="{Binding DiscHeader}" />
                                        <Border Classes="row" Classes.playing="{Binding IsPlaying}">
                                            <Grid
                                                Height="24"
                                                Classes.missing="{Binding !IsAvailable}"
                                                ColumnDefinitions="36,*,52">
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    Classes="secondary"
                                                    FontSize="13"
                                                    Text="{Binding AlbumTrackNumber}" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Classes="track-title"
                                                    Classes.playing="{Binding IsPlaying}"
                                                    FontSize="13"
                                                    FontWeight="Medium"
                                                    Text="{Binding Title}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Grid.Column="2"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Classes="secondary"
                                                    FontSize="13"
                                                    Text="{Binding DurationText}" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Panel>

                <!--  Panel de letra: pegado al borde derecho, separado de la lista por una línea  -->
                <Border
                    x:Name="LyricsPanel"
                    Grid.Column="2"
                    Width="300"
                    Padding="20,22,12,0"
                    BorderBrush="{DynamicResource ThemeOverlayBorderBrush}"
                    BorderThickness="1,0,0,0"
                    IsVisible="{Binding Lyrics.ShowPanel}">
                    <DockPanel>
                        <DockPanel Margin="0,0,0,12" DockPanel.Dock="Top">
                        <!--  Capas: la misma burbuja con «A» que en el modo inmersivo  -->
                        <Button
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Traducción y pronunciación"
                            Classes="icon"
                            DockPanel.Dock="Right"
                            ToolTip.Tip="Traducción y pronunciación">
                            <PathIcon Data="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm0 14H6l-2 2V4h16v12zM11.3 6h1.4l2.8 8h-1.5l-.6-1.8h-2.8l-.6 1.8H8.5zm-.3 5h2l-1-3z" />
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedRight">
                                    <StackPanel MinWidth="260" Spacing="4">
                                        <CheckBox
                                            Content="Mostrar traducción"
                                            IsChecked="{Binding Lyrics.ShowTranslation}"
                                            IsEnabled="{Binding Lyrics.HasTranslation}" />
                                        <CheckBox
                                            Content="Mostrar pronunciación"
                                            IsChecked="{Binding Lyrics.ShowPronunciation}"
                                            IsEnabled="{Binding Lyrics.HasPronunciation}" />
                                        <CheckBox
                                            Content="Ocultar original"
                                            IsChecked="{Binding Lyrics.HideOriginal}"
                                            IsEnabled="{Binding Lyrics.HasExtras}" />
                                        <Separator Margin="0,4" />
                                        <CheckBox
                                            Content="Pronunciación en texto grande"
                                            IsChecked="{Binding Lyrics.EmphasizePronunciation}"
                                            IsEnabled="{Binding Lyrics.HasPronunciation}" />
                                        <TextBlock
                                            FontSize="12"
                                            IsVisible="{Binding !Lyrics.HasExtras}"
                                            Opacity="0.6"
                                            Text="Esta canción no tiene archivos .lrc de traducción ni de pronunciación."
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock
                                FontSize="15"
                                FontWeight="SemiBold"
                                Text="Letra" />
                            <TextBlock
                                Classes="secondary"
                                FontSize="12"
                                Text="{Binding Lyrics.PanelSubtitle}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        </DockPanel>
                        <!--
                            El final se funde con el fondo (mockup 1a). La máscara solo usa el alfa: Black y
                            Transparent no son colores que se vean, por eso no salen de los recursos del tema.
                        -->
                        <ListBox
                            Background="Transparent"
                            Classes="lyrics side"
                            ItemTemplate="{StaticResource SideLyricLineTemplate}"
                            ItemsSource="{Binding Lyrics.Lines}"
                            SelectedIndex="{Binding Lyrics.ActiveIndex, Mode=OneWay}"
                            Tapped="OnLyricTapped">
                            <ListBox.OpacityMask>
                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                    <GradientStop Offset="0.75" Color="Black" />
                                    <GradientStop Offset="1" Color="Transparent" />
                                </LinearGradientBrush>
                            </ListBox.OpacityMask>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!--  Línea de estado (mockup 1a): «Biblioteca al día.» o el último aviso, error o progreso  -->
                <Border
                    x:Name="StatusBar"
                    Grid.Row="1"
                    Grid.Column="1"
                    Grid.ColumnSpan="2"
                    Height="28"
                    Padding="20,0"
                    BorderBrush="{DynamicResource ThemeOverlayBorderBrush}"
                    BorderThickness="0,1,0,0">
                    <TextBlock
                        VerticalAlignment="Center"
                        Classes="secondary"
                        FontSize="12"
                        Text="{Binding Status}"
                        TextTrimming="CharacterEllipsis"
                        ToolTip.Tip="{Binding Status}" />
                </Border>

                <!--
                    Configuración (docs/specs/settings-panel.md): una capa sobre la zona central, no una ventana. Cada
                    opción se guarda al cambiarla. Solo CheckBox y Button (y el desplegable de «Tema», cuyas teclas atiende la
                    ventana), para no ampliar OwnsKeyboard. Rediseño (docs/specs/redesign-mockups.md): «Volver a la
                    biblioteca» arriba, columna centrada de 640 px y cada grupo en una tarjeta.
                -->
                <DockPanel
                    Grid.RowSpan="2"
                    Grid.ColumnSpan="3"
                    Background="{DynamicResource ThemeBackgroundBrush}"
                    IsVisible="{Binding Settings.IsOpen}">
                    <Border
                        Height="56"
                        Padding="20,0"
                        BorderBrush="{DynamicResource ThemeOverlayBorderBrush}"
                        BorderThickness="0,0,0,1"
                        DockPanel.Dock="Top">
                        <DockPanel>
                            <TextBlock
                                VerticalAlignment="Center"
                                Classes="secondary"
                                DockPanel.Dock="Right"
                                FontSize="12"
                                Text="Esc cierra" />
                            <Button
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Volver a la biblioteca"
                                Classes="action"
                                Command="{Binding Settings.CloseCommand}"
                                ToolTip.Tip="Cerrar la configuración (Esc)">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <PathIcon Data="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z" />
                                    <TextBlock Classes="label" Text="Volver a la biblioteca" />
                                </StackPanel>
                            </Button>
                        </DockPanel>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel
                            MaxWidth="640"
                            Margin="24,32"
                            Spacing="28">
                            <TextBlock
                                FontSize="26"
                                FontWeight="Bold"
                                Text="Configuración" />

                            <StackPanel Spacing="10">
                                <TextBlock Classes="section" Text="APARIENCIA" />
                                <Border Classes="card">
                                    <Border Classes="card-row">
                                        <DockPanel>
                                            <!--  Tema: la lista previsualiza al pasar el cursor o con las flechas; clic o Enter confirma  -->
                                            <Button
                                                x:Name="ThemeButton"
                                                MinWidth="200"
                                                Margin="16,0,0,0"
                                                VerticalAlignment="Top"
                                                HorizontalContentAlignment="Stretch"
                                                AutomationProperties.Name="Tema"
                                                Classes="action"
                                                DockPanel.Dock="Right"
                                                ToolTip.Tip="Cambiar el tema">
                                                <Button.Content>
                                                    <DockPanel>
                                                        <PathIcon
                                                            Margin="12,0,0,0"
                                                            Data="M7.41 8.59L12 13.17l4.59-4.58L18 10l-6 6-6-6 1.41-1.41z"
                                                            DockPanel.Dock="Right" />
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            Text="{Binding Themes.CommittedName}"
                                                            TextTrimming="CharacterEllipsis" />
                                                    </DockPanel>
                                                </Button.Content>
                                                <Button.Flyout>
                                                    <Flyout
                                                        Closed="OnThemeFlyoutClosed"
                                                        Opened="OnThemeFlyoutOpened"
                                                        Placement="BottomEdgeAlignedLeft">
                                                        <StackPanel Width="220" Spacing="8">
                                                            <ListBox
                                                                x:Name="ThemeList"
                                                                ItemsSource="{Binding Themes.Items}"
                                                                PointerExited="OnThemeListPointerExited"
                                                                PointerMoved="OnThemeListPointerMoved"
                                                                SelectedItem="{Binding Themes.SelectedChoice}"
                                                                Tapped="OnThemeListTapped">
                                                                <ListBox.ItemTemplate>
                                                                    <DataTemplate x:DataType="vm:ThemeChoice">
                                                                        <TextBlock Text="{Binding Name}" />
                                                                    </DataTemplate>
                                                                </ListBox.ItemTemplate>
                                                            </ListBox>
                                                            <Button
                                                                HorizontalAlignment="Stretch"
                                                                HorizontalContentAlignment="Center"
                                                                Click="OnOpenThemesFolder"
                                                                Content="Carpeta de temas"
                                                                Focusable="False" />
                                                        </StackPanel>
                                                    </Flyout>
                                                </Button.Flyout>
                                            </Button>
                                            <StackPanel Spacing="3">
                                                <TextBlock Classes="option-title" Text="Tema" />
                                                <TextBlock
                                                    Classes="settings-help"
                                                    Text="Pasa el cursor o usa las flechas para previsualizar. Enter confirma; Esc vuelve al anterior."
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </Border>
                            </StackPanel>

                            <StackPanel Spacing="10">
                                <TextBlock Classes="section" Text="REPRODUCCIÓN" />
                                <Border Classes="card">
                                    <Border Classes="card-row">
                                        <CheckBox AutomationProperties.Name="Reproducir con un solo clic" IsChecked="{Binding Settings.PlayOnSingleClick}">
                                            <StackPanel Spacing="3">
                                                <TextBlock Classes="option-title" Text="Reproducir con un solo clic" />
                                                <TextBlock
                                                    Classes="settings-help"
                                                    Text="Desactivado, un clic selecciona la canción y el doble clic la reproduce. Con Ctrl o Mayús el clic solo selecciona."
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                        </CheckBox>
                                    </Border>
                                </Border>
                            </StackPanel>

                            <StackPanel IsVisible="{Binding Settings.IsWindows}" Spacing="10">
                                <TextBlock Classes="section" Text="ISLA FLOTANTE" />
                                <Border Classes="card">
                                    <StackPanel>
                                        <Border Classes="card-row divided">
                                            <CheckBox AutomationProperties.Name="Mostrar la isla flotante" IsChecked="{Binding ShowIsland}">
                                                <StackPanel Spacing="3">
                                                    <TextBlock Classes="option-title" Text="Mostrar la isla flotante" />
                                                    <TextBlock
                                                        Classes="settings-help"
                                                        Text="Una pastilla arriba al centro de la pantalla muestra lo que suena cuando el reproductor está minimizado o detrás de otra ventana."
                                                        TextWrapping="Wrap" />
                                                </StackPanel>
                                            </CheckBox>
                                        </Border>
                                        <Border Classes="card-row">
                                            <CheckBox
                                                AutomationProperties.Name="Mostrar el título en la isla"
                                                IsChecked="{Binding Settings.IslandShowTitle}"
                                                IsEnabled="{Binding ShowIsland}">
                                                <StackPanel Spacing="3">
                                                    <TextBlock Classes="option-title" Text="Mostrar el título en la isla" />
                                                    <TextBlock
                                                        Classes="settings-help"
                                                        Text="La isla sin desplegar muestra el título y el artista. Si no caben, el texto se desplaza mientras suena la música."
                                                        TextWrapping="Wrap" />
                                                </StackPanel>
                                            </CheckBox>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel IsVisible="{Binding Settings.IsWindows}" Spacing="10">
                                <TextBlock Classes="section" Text="SEGUNDO PLANO" />
                                <Border Classes="card">
                                    <Border Classes="card-row">
                                        <CheckBox AutomationProperties.Name="Seguir sonando al cerrar la ventana" IsChecked="{Binding Settings.KeepRunningOnClose}">
                                            <StackPanel Spacing="3">
                                                <TextBlock Classes="option-title" Text="Seguir sonando al cerrar la ventana" />
                                                <TextBlock
                                                    Classes="settings-help"
                                                    Text="Al cerrar la ventana, el reproductor se queda en la bandeja del sistema (junto al reloj) y la música sigue. Un clic en su icono vuelve a abrirlo; para cerrarlo del todo, clic derecho en el icono y «Salir», o el botón «Salir» de la isla flotante."
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                        </CheckBox>
                                    </Border>
                                </Border>
                            </StackPanel>

                            <StackPanel Spacing="10">
                                <TextBlock Classes="section" Text="DATOS" />
                                <Border Classes="card">
                                    <Border Classes="card-row">
                                        <DockPanel>
                                            <Button
                                                Margin="16,0,0,0"
                                                VerticalAlignment="Center"
                                                AutomationProperties.Name="Abrir carpeta"
                                                Classes="action"
                                                Click="OnOpenDataFolder"
                                                DockPanel.Dock="Right">
                                                <TextBlock Classes="label" Text="Abrir carpeta" />
                                            </Button>
                                            <StackPanel Spacing="3">
                                                <TextBlock Classes="option-title" Text="Carpeta de datos" />
                                                <TextBlock
                                                    Classes="settings-help"
                                                    Text="La biblioteca, las playlists, los ajustes y los temas se guardan aquí:"
                                                    TextWrapping="Wrap" />
                                                <TextBlock
                                                    Classes="secondary"
                                                    FontFamily="Cascadia Mono,Consolas,monospace"
                                                    FontSize="12"
                                                    Text="{Binding Settings.DataFolder}"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Grid>

        </DockPanel>

        <!--  Modo inmersivo  -->
        <ThemeVariantScope RequestedThemeVariant="Dark">
            <Grid Background="#FF101010" IsVisible="{Binding IsImmersive}">
                <!--  Fondo: la portada ampliada y desenfocada, una sola vez (no un Effect que se recalcula en cada fotograma)  -->
                <controls:BlurredBackdrop
                    BlurRadius="60"
                    Opacity="0.9"
                    RenderOptions.BitmapInterpolationMode="HighQuality"
                    Source="{Binding NowPlayingCover}" />
                <!--  Velo en degradado para que el texto siempre se lea  -->
                <Border>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                            <GradientStop Offset="0" Color="#99000000" />
                            <GradientStop Offset="1" Color="#E6000000" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Button
                    Margin="16"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    AutomationProperties.Name="Cerrar"
                    Classes="icon"
                    Command="{Binding CloseImmersiveCommand}"
                    ToolTip.Tip="Cerrar">
                    <PathIcon Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" />
                </Button>
                <!--
                    Capas de la letra (docs/specs/lyrics-layers.md, criterios 12-16): burbuja con una «A», distinta del
                    icono de «Letra». Las opciones se calculan en Core al abrir el menú (OnLayersMenuOpening).
                -->
                <Button
                    x:Name="LayersButton"
                    Margin="16"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    AutomationProperties.Name="Traducción y pronunciación"
                    Classes="icon"
                    IsVisible="{Binding Lyrics.ShowLayersButton}"
                    ToolTip.Tip="Traducción y pronunciación">
                    <PathIcon Data="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm0 14H6l-2 2V4h16v12zM11.3 6h1.4l2.8 8h-1.5l-.6-1.8h-2.8l-.6 1.8H8.5zm-.3 5h2l-1-3z" />
                    <Button.Flyout>
                        <MenuFlyout
                            Closed="OnLayersMenuClosed"
                            Opened="OnLayersMenuOpened"
                            Opening="OnLayersMenuOpening"
                            Placement="BottomEdgeAlignedRight" />
                    </Button.Flyout>
                </Button>
                <Grid Margin="48,72,48,32" ColumnDefinitions="*,*">
                    <!--  Izquierda: carátula, datos y controles  -->
                    <StackPanel
                        Grid.Column="0"
                        MaxWidth="400"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="16">
                        <Border
                            Width="360"
                            Height="360"
                            Background="#22FFFFFF"
                            ClipToBounds="True"
                            CornerRadius="12">
                            <Panel>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="96"
                                    Opacity="0.4"
                                    Text="♪" />
                                <Image Source="{Binding NowPlayingCover}" Stretch="UniformToFill" />
                            </Panel>
                        </Border>
                        <StackPanel Spacing="2">
                            <TextBlock
                                FontSize="22"
                                FontWeight="Bold"
                                Text="{Binding CurrentTrack.Title}"
                                TextTrimming="CharacterEllipsis" />
                            <!--  «Artista · Álbum», como en el diseño del inmersivo  -->
                            <TextBlock
                                FontSize="15"
                                Opacity="0.7"
                                TextTrimming="CharacterEllipsis">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0} · {1}">
                                        <Binding Path="CurrentTrack.Artist" />
                                        <Binding Path="CurrentTrack.Album" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>
                        <Grid ColumnDefinitions="48,*,48">
                            <TextBlock
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Text="{Binding PositionText}" />
                            <Slider
                                Grid.Column="1"
                                Classes="progress"
                                Maximum="{Binding DurationSeconds}"
                                Minimum="0"
                                Value="{Binding PositionSeconds}" />
                            <TextBlock
                                Grid.Column="2"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Text="{Binding DurationText}" />
                        </Grid>
                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="8">
                            <ToggleButton
                                AutomationProperties.Name="Aleatorio"
                                Classes="icon"
                                Classes.active="{Binding IsShuffleOn}"
                                IsChecked="{Binding IsShuffleOn}"
                                ToolTip.Tip="Aleatorio">
                                <Panel Width="36" Height="36">
                                    <PathIcon
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Data="M10.59 9.17L5.41 4 4 5.41l5.17 5.17 1.42-1.41zM14.5 4l2.04 2.04L4 18.59 5.41 20 17.96 7.46 20 9.5V4h-5.5zm.33 9.41l-1.41 1.41 3.13 3.13L14.5 20H20v-5.5l-2.04 2.04-3.13-3.13z" />
                                    <Ellipse
                                        Width="4"
                                        Height="4"
                                        Margin="0,0,0,3"
                                        VerticalAlignment="Bottom"
                                        Fill="{DynamicResource ThemeAccentBrush}"
                                        IsVisible="{Binding IsShuffleOn}" />
                                </Panel>
                            </ToggleButton>
                            <Button
                                AutomationProperties.Name="Anterior"
                                Classes="icon skip"
                                Command="{Binding PreviousCommand}"
                                ToolTip.Tip="Anterior">
                                <PathIcon Data="M6 6h2v12H6zm3.5 6l8.5 6V6z" />
                            </Button>
                            <Button
                                AutomationProperties.Name="{Binding PlayPauseText}"
                                Classes="play"
                                Command="{Binding TogglePlayPauseCommand}"
                                ToolTip.Tip="{Binding PlayPauseText}">
                                <Panel Classes="pp" Classes.playing="{Binding IsPlaying}">
                                    <PathIcon Classes="glyph-play" Data="M8 5v14l11-7z" />
                                    <PathIcon Classes="glyph-pause" Data="M6 19h4V5H6v14zm8-14v14h4V5h-4z" />
                                </Panel>
                            </Button>
                            <Button
                                AutomationProperties.Name="Siguiente"
                                Classes="icon skip"
                                Command="{Binding NextCommand}"
                                ToolTip.Tip="Siguiente">
                                <PathIcon Data="M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z" />
                            </Button>
                            <Button
                                AutomationProperties.Name="{Binding RepeatText}"
                                Classes="icon"
                                Classes.active="{Binding RepeatText, Converter={x:Static ObjectConverters.NotEqual}, ConverterParameter='Repetir: no'}"
                                Command="{Binding CycleRepeatCommand}"
                                ToolTip.Tip="{Binding RepeatText}">
                                <Panel Width="36" Height="36">
                                    <PathIcon
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Data="M7 7h10v3l4-4-4-4v3H5v6h2V7zm10 10H7v-3l-4 4 4 4v-3h12v-6h-2v4z" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="8"
                                        FontWeight="Bold"
                                        IsVisible="{Binding RepeatText, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='Repetir: una'}"
                                        Text="1" />
                                    <Ellipse
                                        Width="4"
                                        Height="4"
                                        Margin="0,0,0,3"
                                        VerticalAlignment="Bottom"
                                        Fill="{DynamicResource ThemeAccentBrush}"
                                        IsVisible="{Binding RepeatText, Converter={x:Static ObjectConverters.NotEqual}, ConverterParameter='Repetir: no'}" />
                                </Panel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                    <!--  Derecha: letras con la misma plantilla que el panel lateral  -->
                    <Panel Grid.Column="1" Margin="32,0,0,0">
                        <!--  Letra sincronizada: progresiva (docs/specs/lyrics-progressive.md)  -->
                        <controls:ProgressiveLyricsView
                            DimForeground="#59FFFFFF"
                            IsPlaying="{Binding IsPlaying}"
                            IsVisible="{Binding Lyrics.ShowProgressiveImmersive}"
                            Source="{Binding Lyrics}">
                            <controls:ProgressiveLyricsView.IsShown>
                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                    <Binding Path="IsImmersive" />
                                    <Binding Path="Lyrics.ShowProgressiveImmersive" />
                                </MultiBinding>
                            </controls:ProgressiveLyricsView.IsShown>
                        </controls:ProgressiveLyricsView>
                        <ListBox
                            Background="Transparent"
                            Classes="lyrics"
                            IsVisible="{Binding Lyrics.ShowClassicImmersive}"
                            ItemTemplate="{StaticResource LyricLineTemplate}"
                            ItemsSource="{Binding Lyrics.Lines}"
                            SelectedIndex="{Binding Lyrics.ActiveIndex, Mode=OneWay}"
                            Tapped="OnLyricTapped" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsVisible="{Binding !Lyrics.IsAvailable}"
                            Opacity="0.6"
                            Text="Sin letra disponible para esta canción" />
                    </Panel>
                </Grid>
            </Grid>
        </ThemeVariantScope>
    </Grid>
</Window>
