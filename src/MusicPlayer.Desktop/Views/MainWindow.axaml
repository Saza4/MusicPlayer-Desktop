<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MusicPlayer.Desktop.ViewModels"
        x:Class="MusicPlayer.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="MusicPlayer" Width="960" Height="600" MinWidth="640" MinHeight="400">

    <Window.Resources>
        <DataTemplate x:Key="LyricLineTemplate" x:DataType="vm:LyricLineViewModel">
            <StackPanel Spacing="2" Margin="8,6" Background="Transparent"
                        Classes.synced="{Binding IsSynced}"
                        Classes.active="{Binding IsActive}">
                <TextBlock Classes="lead" TextWrapping="Wrap"
                           Text="{Binding Pronunciation}"
                           IsVisible="{Binding ShowPronunciation}"
                           FontSize="{Binding PronunciationFontSize}"/>
                <TextBlock Classes="lead" TextWrapping="Wrap"
                           Text="{Binding Text}"
                           IsVisible="{Binding ShowOriginal}"
                           FontSize="{Binding OriginalFontSize}"/>
                <TextBlock TextWrapping="Wrap" FontStyle="Italic"
                           Text="{Binding Translation}"
                           IsVisible="{Binding ShowTranslation}"
                           FontSize="{Binding TranslationFontSize}"/>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="Style Selector" /> <!-- Preservado de estructura base -->
        <Style Selector="Grid.missing">
            <Setter Property="Opacity" Value="0.45"/>
        </Style>
        <Style Selector="ListBox.lyrics ListBoxItem">
            <Setter Property="Padding" Value="0"/>
        </Style>
        <!-- La línea activa se resalta con el TextBlock, no con la selección del ListBox -->
        <Style Selector="ListBox.lyrics ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBox.lyrics ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBox.lyrics StackPanel.synced">
            <Setter Property="Opacity" Value="0.45"/>
        </Style>
        <Style Selector="ListBox.lyrics StackPanel.synced.active">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="ListBox.lyrics StackPanel.active TextBlock.lead">
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </Window.Styles>

    <Grid>
        <DockPanel>

            <!-- Barra superior -->
            <Border DockPanel.Dock="Top" Padding="16,12"
                    BorderThickness="0,0,0,1" BorderBrush="#33FFFFFF">
                <DockPanel>
                    <Button DockPanel.Dock="Left" Content="Agregar carpeta"
                            Command="{Binding AddFolderCommand}"/>
                    <TextBox DockPanel.Dock="Right" Width="280"
                             Text="{Binding SearchText}"
                             Watermark="Buscar por título, artista o álbum"/>
                    <TextBlock Text="{Binding Status}" Margin="16,0"
                               VerticalAlignment="Center" Opacity="0.7"/>
                </DockPanel>
            </Border>

            <!-- Barra de confirmación de eliminación -->
            <Border DockPanel.Dock="Top" Padding="16,10" Background="#33E57373"
                    IsVisible="{Binding IsConfirmingDelete}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                        <Button Content="Eliminar del disco" Command="{Binding ConfirmDeleteTrackCommand}"/>
                        <Button Content="Cancelar" Command="{Binding CancelDeleteTrackCommand}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding DeletePrompt}" TextWrapping="Wrap"
                               VerticalAlignment="Center" Margin="0,0,16,0"/>
                </DockPanel>
            </Border>

            <!-- Barra de aviso -->
            <Border DockPanel.Dock="Top" Padding="16,10" Background="#33FFB74D"
                    IsVisible="{Binding HasMissing}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                        <Button Content="Volver a revisar" Command="{Binding CheckAvailabilityCommand}"
                                IsVisible="{Binding !IsConfirmingPrune}"/>
                        <Button Content="Quitar de la biblioteca…" Command="{Binding AskPruneCommand}"
                                IsVisible="{Binding !IsConfirmingPrune}"/>
                        <Button Content="Quitar" Command="{Binding ConfirmPruneCommand}"
                                IsVisible="{Binding IsConfirmingPrune}"/>
                        <Button Content="Cancelar" Command="{Binding CancelPruneCommand}"
                                IsVisible="{Binding IsConfirmingPrune}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding MissingPrompt}" TextWrapping="Wrap"
                               VerticalAlignment="Center" Margin="0,0,16,0"/>
                </DockPanel>
            </Border>

            <!-- Controles de reproducción -->
            <Border DockPanel.Dock="Bottom" Padding="16,12"
                    BorderThickness="0,1,0,0" BorderBrush="#33FFFFFF">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                        <Button Command="{Binding OpenImmersiveCommand}" Padding="0"
                                Width="48" Height="48" ClipToBounds="True"
                                ToolTip.Tip="Pantalla completa">
                            <Panel>
                                <TextBlock Text="♪" FontSize="22" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" Opacity="0.5"/>
                                <Image Source="{Binding NowPlayingCover}" Stretch="UniformToFill"/>
                            </Panel>
                        </Button>
                        <TextBlock Text="{Binding NowPlaying}" VerticalAlignment="Center"
                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="500"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                        <Button Content="Anterior" Command="{Binding PreviousCommand}"/>
                        <Button Content="{Binding PlayPauseText}"
                                Command="{Binding TogglePlayPauseCommand}"
                                MinWidth="100" HorizontalContentAlignment="Center"/>
                        <Button Content="Siguiente" Command="{Binding NextCommand}"/>
                        <ToggleButton Content="Aleatorio" IsChecked="{Binding IsShuffleOn}"/>
                        <Button Content="{Binding RepeatText}" Command="{Binding CycleRepeatCommand}"
                                MinWidth="130" HorizontalContentAlignment="Center"/>
                        <Button Content="Letra"
                                Command="{Binding Lyrics.ToggleOpenCommand}"
                                IsEnabled="{Binding Lyrics.IsAvailable}"/>
                        <Button Content="Pantalla completa" Command="{Binding OpenImmersiveCommand}"/>
                        <TextBlock Text="Vol." VerticalAlignment="Center" Margin="16,0,0,0" Opacity="0.7"/>
                        <Slider Minimum="0" Maximum="1" Width="120" VerticalAlignment="Center"
                                Value="{Binding Volume}"/>
                    </StackPanel>

                    <Grid ColumnDefinitions="56,*,56">
                        <TextBlock Grid.Column="0" Text="{Binding PositionText}"
                                   VerticalAlignment="Center"/>
                        <Slider Grid.Column="1" Minimum="0"
                                Maximum="{Binding DurationSeconds}"
                                Value="{Binding PositionSeconds}"/>
                        <TextBlock Grid.Column="2" Text="{Binding DurationText}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Barra lateral, Lista de canciones y Panel de letras -->
            <Grid ColumnDefinitions="220,*,Auto">
                <DockPanel Grid.Column="0" Margin="8,8,0,8">
                    <!-- Panel de edición (crear / renombrar / confirmar eliminación) -->
                    <Border DockPanel.Dock="Bottom" Margin="0,8,0,0" Padding="8" CornerRadius="8"
                            Background="#18FFFFFF" IsVisible="{Binding Playlists.IsEditing}">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{Binding Playlists.Prompt}" TextWrapping="Wrap"
                                       FontWeight="SemiBold"/>
                            <TextBox x:Name="PlaylistNameBox" Watermark="Nombre" MaxLength="80"
                                     Text="{Binding Playlists.NameDraft}"
                                     IsVisible="{Binding Playlists.IsNameInput}"
                                     KeyDown="OnPlaylistNameKeyDown"/>
                            <TextBlock Text="{Binding Playlists.EditError}" TextWrapping="Wrap"
                                       Foreground="#FFE57373"
                                       IsVisible="{Binding Playlists.HasEditError}"/>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Content="{Binding Playlists.ConfirmText}"
                                        Command="{Binding Playlists.ConfirmEditCommand}"/>
                                <Button Content="Cancelar"
                                        Command="{Binding Playlists.CancelEditCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <!-- Renombrar / eliminar: solo con una playlist seleccionada -->
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="6" Margin="0,8,0,0"
                                IsVisible="{Binding Playlists.HasPlaylistSelected}">
                        <Button Content="Renombrar" Command="{Binding Playlists.BeginRenameCommand}"/>
                        <Button Content="Eliminar" Command="{Binding Playlists.BeginDeleteCommand}"/>
                    </StackPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Content="+" Padding="10,2"
                                Command="{Binding Playlists.BeginCreateCommand}"
                                ToolTip.Tip="Nueva playlist"/>
                        <TextBlock Text="COLECCIONES" FontSize="12" Opacity="0.6"
                                   VerticalAlignment="Center" Margin="8,0"/>
                    </DockPanel>
                    <ListBox ItemsSource="{Binding Playlists.Items}"
                             SelectedItem="{Binding Playlists.Selected}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:PlaylistItemViewModel">
                                <DockPanel Margin="4">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}"
                                               Opacity="0.6" Margin="8,0,0,0"/>
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <DockPanel Grid.Column="1" Margin="8">
                    <TabStrip DockPanel.Dock="Top" Margin="0,0,0,6"
                              IsVisible="{Binding ShowModeTabs}"
                              SelectedIndex="{Binding BrowseIndex}">
                        <TabStripItem Content="Canciones"/>
                        <TabStripItem Content="Álbumes"/>
                        <TabStripItem Content="Artistas"/>
                    </TabStrip>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6" IsVisible="{Binding ShowBackBar}">
                        <Button DockPanel.Dock="Left" Content="{Binding BackText}" Command="{Binding GoBackCommand}"/>
                        <Button DockPanel.Dock="Right" Content="▶ Reproducir" Command="{Binding PlayScopeCommand}"/>
                        <TextBlock Text="{Binding BrowseTitle}" FontWeight="SemiBold" Margin="12,0"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                    <Panel>
                        <!-- Canciones: el mismo ListBox de antes, con IsVisible nuevo -->
                        <ListBox IsVisible="{Binding ShowSongs}"
                                 ItemsSource="{Binding Tracks}"
                                 SelectedItem="{Binding SelectedTrack}"
                                 DoubleTapped="OnTrackDoubleTapped"
                                 ContextRequested="OnTrackListContextRequested">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:TrackItemViewModel">
                                    <Grid ColumnDefinitions="Auto,3*,2*,Auto" Margin="8,4"
                                          Classes.missing="{Binding !IsAvailable}">
                                        <!-- Thumbnail de Canciones -->
                                        <Border Grid.Column="0" Width="40" Height="40" Margin="0,0,12,0"
                                                CornerRadius="4" ClipToBounds="True" Background="#22FFFFFF">
                                            <Image Source="{Binding Cover}" Stretch="UniformToFill"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding Title}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Artist}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Opacity="0.7"/>
                                        <TextBlock Grid.Column="3" Text="{Binding TrailingText}"
                                                   VerticalAlignment="Center" Margin="12,0,0,0" Opacity="0.7"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <ListBox IsVisible="{Binding ShowAlbums}" ItemsSource="{Binding Albums}"
                                 Tapped="OnBrowseTapped">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:AlbumItemViewModel">
                                    <Grid ColumnDefinitions="Auto,*" Margin="8,4">
                                        <!-- Thumbnail de Álbumes -->
                                        <Border Width="56" Height="56" Margin="0,0,12,0" CornerRadius="4"
                                                ClipToBounds="True" Background="#22FFFFFF">
                                            <Image Source="{Binding Cover}" Stretch="UniformToFill"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Subtitle}" Opacity="0.7"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <ListBox IsVisible="{Binding ShowArtists}" ItemsSource="{Binding Artists}"
                                 Tapped="OnBrowseTapped">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:ArtistItemViewModel">
                                    <Grid ColumnDefinitions="Auto,*" Margin="8,4">
                                        <!-- Thumbnail de Artistas -->
                                        <Border Width="56" Height="56" Margin="0,0,12,0" CornerRadius="4"
                                                ClipToBounds="True" Background="#22FFFFFF">
                                            <Image Source="{Binding Cover}" Stretch="UniformToFill"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Summary}" Opacity="0.7"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Panel>
                </DockPanel>

                <Border Grid.Column="2" Width="380" Margin="0,8,8,8" Padding="8"
                        IsVisible="{Binding Lyrics.ShowPanel}"
                        BorderThickness="1" BorderBrush="#33FFFFFF" CornerRadius="8">
                    <DockPanel>
                        <Button DockPanel.Dock="Top" Margin="0,0,0,8"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Content="Traducción y pronunciación">
                            <Button.Flyout>
                                <Flyout Placement="Bottom">
                                    <StackPanel Spacing="4" MinWidth="260">
                                        <CheckBox Content="Mostrar traducción"
                                                  IsChecked="{Binding Lyrics.ShowTranslation}"
                                                  IsEnabled="{Binding Lyrics.HasTranslation}"/>
                                        <CheckBox Content="Mostrar pronunciación"
                                                  IsChecked="{Binding Lyrics.ShowPronunciation}"
                                                  IsEnabled="{Binding Lyrics.HasPronunciation}"/>
                                        <CheckBox Content="Ocultar original"
                                                  IsChecked="{Binding Lyrics.HideOriginal}"
                                                  IsEnabled="{Binding Lyrics.HasExtras}"/>
                                        <Separator Margin="0,4"/>
                                        <CheckBox Content="Pronunciación en texto grande"
                                                  IsChecked="{Binding Lyrics.EmphasizePronunciation}"
                                                  IsEnabled="{Binding Lyrics.HasPronunciation}"/>
                                        <TextBlock Text="Esta canción no tiene archivos .lrc de traducción ni de pronunciación."
                                                   TextWrapping="Wrap" FontSize="12" Opacity="0.6"
                                                   IsVisible="{Binding !Lyrics.HasExtras}"/>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <ListBox Classes="lyrics" Background="Transparent"
                                 ItemsSource="{Binding Lyrics.Lines}"
                                 SelectedIndex="{Binding Lyrics.ActiveIndex, Mode=OneWay}"
                                 ItemTemplate="{StaticResource LyricLineTemplate}"
                                 Tapped="OnLyricTapped"/>
                    </DockPanel>
                </Border>
            </Grid>

        </DockPanel>

        <!-- Modo inmersivo -->
        <ThemeVariantScope RequestedThemeVariant="Dark">
            <Grid IsVisible="{Binding IsImmersive}" Background="#FF101010">
                <!-- Fondo: la portada ampliada y desenfocada -->
                <Image Source="{Binding NowPlayingCover}" Stretch="UniformToFill"
                       Effect="blur(60)" Opacity="0.9"/>
                <!-- Velo en degradado para que el texto siempre se lea -->
                <Border>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                            <GradientStop Color="#99000000" Offset="0"/>
                            <GradientStop Color="#E6000000" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Button HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16"
                        Content="✕  Cerrar" Command="{Binding CloseImmersiveCommand}"/>
                <Grid ColumnDefinitions="*,*" Margin="48,72,48,32">
                    <!-- Izquierda: carátula, datos y controles -->
                    <StackPanel Grid.Column="0" Spacing="16" MaxWidth="400"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="360" Height="360" CornerRadius="12" ClipToBounds="True"
                                Background="#22FFFFFF">
                            <Panel>
                                <TextBlock Text="♪" FontSize="96" Opacity="0.4"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Image Source="{Binding NowPlayingCover}" Stretch="UniformToFill"/>
                            </Panel>
                        </Border>
                        <StackPanel Spacing="2">
                            <TextBlock Text="{Binding CurrentTrack.Title}" FontSize="22"
                                       FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding CurrentTrack.Artist}" Opacity="0.7"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Grid ColumnDefinitions="48,*,48">
                            <TextBlock Grid.Column="0" Text="{Binding PositionText}"
                                       VerticalAlignment="Center"/>
                            <Slider Grid.Column="1" Minimum="0"
                                    Maximum="{Binding DurationSeconds}"
                                    Value="{Binding PositionSeconds}"/>
                            <TextBlock Grid.Column="2" Text="{Binding DurationText}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <Button Content="Anterior" Command="{Binding PreviousCommand}"/>
                            <Button Content="{Binding PlayPauseText}"
                                    Command="{Binding TogglePlayPauseCommand}"
                                    MinWidth="100" HorizontalContentAlignment="Center"/>
                            <Button Content="Siguiente" Command="{Binding NextCommand}"/>
                            <ToggleButton Content="Aleatorio" IsChecked="{Binding IsShuffleOn}"/>
                            <Button Content="{Binding RepeatText}" Command="{Binding CycleRepeatCommand}"
                                    MinWidth="130" HorizontalContentAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                    <!-- Derecha: letras con la misma plantilla que el panel lateral -->
                    <Panel Grid.Column="1" Margin="32,0,0,0">
                        <ListBox Classes="lyrics" Background="Transparent"
                                 IsVisible="{Binding Lyrics.IsAvailable}"
                                 ItemsSource="{Binding Lyrics.Lines}"
                                 SelectedIndex="{Binding Lyrics.ActiveIndex, Mode=OneWay}"
                                 ItemTemplate="{StaticResource LyricLineTemplate}"
                                 Tapped="OnLyricTapped"/>
                        <TextBlock Text="Sin letra disponible para esta canción" Opacity="0.6"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   IsVisible="{Binding !Lyrics.IsAvailable}"/>
                    </Panel>
                </Grid>
            </Grid>
        </ThemeVariantScope>
    </Grid>
</Window>