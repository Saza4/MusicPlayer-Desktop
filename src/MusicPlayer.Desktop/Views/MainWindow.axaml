<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MusicPlayer.Desktop.ViewModels"
        x:Class="MusicPlayer.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="MusicPlayer" Width="960" Height="600">
    <StackPanel Margin="24" Spacing="12" MaxWidth="600" VerticalAlignment="Center">
        <TextBox Text="{Binding FilePath}" Watermark="Ruta a un .mp3 o .wav"/>
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Reproducir" Command="{Binding LoadAndPlayCommand}"/>
            <Button Content="Pausa" Command="{Binding PauseCommand}"/>
            <Button Content="Detener" Command="{Binding StopCommand}"/>
        </StackPanel>
        <TextBlock Text="{Binding Status}"/>
    </StackPanel>
</Window>