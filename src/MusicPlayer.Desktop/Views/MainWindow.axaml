<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MusicPlayer.Desktop.ViewModels"
        x:Class="MusicPlayer.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="MusicPlayer" Width="960" Height="600" MinWidth="640" MinHeight="400">

    <DockPanel>

        <!-- Barra superior -->
        <Border DockPanel.Dock="Top" Padding="16,12"
                BorderThickness="0,0,0,1" BorderBrush="#33FFFFFF">
            <DockPanel>
                <Button DockPanel.Dock="Left" Content="Agregar carpeta"
                        Command="{Binding AddFolderCommand}"/>
                <TextBlock Text="{Binding Status}" Margin="16,0,0,0"
                           VerticalAlignment="Center" Opacity="0.7"/>
            </DockPanel>
        </Border>

        <!-- Controles de reproducción -->
        <Border DockPanel.Dock="Bottom" Padding="16,12"
                BorderThickness="0,1,0,0" BorderBrush="#33FFFFFF">
            <StackPanel Spacing="8">
                <TextBlock Text="{Binding NowPlaying}" HorizontalAlignment="Center"
                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>

                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                    <Button Content="Anterior" Command="{Binding PreviousCommand}"/>
                    <Button Content="{Binding PlayPauseText}"
                            Command="{Binding TogglePlayPauseCommand}"
                            MinWidth="100" HorizontalContentAlignment="Center"/>
                    <Button Content="Siguiente" Command="{Binding NextCommand}"/>
                </StackPanel>

                <Grid ColumnDefinitions="56,*,56">
                    <TextBlock Grid.Column="0" Text="{Binding PositionText}"
                               VerticalAlignment="Center"/>
                    <Slider Grid.Column="1" Minimum="0"
                            Maximum="{Binding DurationSeconds}"
                            Value="{Binding PositionSeconds}"/>
                    <TextBlock Grid.Column="2" Text="{Binding DurationText}"
                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Lista de canciones -->
        <ListBox Margin="8"
                 ItemsSource="{Binding Tracks}"
                 SelectedItem="{Binding SelectedTrack}"
                 DoubleTapped="OnTrackDoubleTapped">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:TrackItemViewModel">
                    <Grid ColumnDefinitions="3*,2*,Auto" Margin="8,6">
                        <TextBlock Grid.Column="0" Text="{Binding Title}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="1" Text="{Binding Artist}"
                                   TextTrimming="CharacterEllipsis" Opacity="0.7"/>
                        <TextBlock Grid.Column="2" Text="{Binding DurationText}"
                                   Margin="12,0,0,0" Opacity="0.7"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

    </DockPanel>
</Window>