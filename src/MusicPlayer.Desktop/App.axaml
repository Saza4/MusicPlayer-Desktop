<Application
    x:Class="MusicPlayer.Desktop.App"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedThemeVariant="Dark">
    <!--
        Variante inicial: Oscuro. ThemeService la cambia al arrancar según el tema guardado (Claro, Oscuro,
        Sistema o un tema de usuario). Los colores salen de Themes/ThemeBrushes.axaml: no escribas literales aquí.
    -->

    <Application.Styles>
        <FluentTheme />

        <!--  Skin: contenedores y paneles flotantes  -->
        <Style Selector="ListBox">
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBrush}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="4" />
        </Style>
        <!--  Fila seleccionada / canción en reproducción: velo translúcido en lugar del azul de acento  -->
        <Style Selector="ListBox ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ThemeOverlayHoverBrush}" />
        </Style>
        <Style Selector="ListBox ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ThemeOverlaySelectedBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
        </Style>
        <Style Selector="ListBox ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ThemeOverlaySelectedHoverBrush}" />
        </Style>
        <Style Selector="ListBox ListBoxItem:selected:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ThemeOverlaySelectedBrush}" />
        </Style>
        <Style Selector="FlyoutPresenter">
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeOverlayBorderStrongBrush}" />
        </Style>
        <Style Selector="MenuFlyoutPresenter">
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeOverlayBorderStrongBrush}" />
        </Style>
        <!--
            Menú de capas del modo inmersivo (MainWindow.FillLayersMenu le pone la clase «immersive»): en lugar de una
            caja negra plana, vidrio oscuro con esquinas redondeadas y filas con velo blanco, como los botones del
            inmersivo. Siempre oscuro, con texto blanco: el inmersivo lo es con cualquier tema.
        -->
        <Style Selector="MenuFlyoutPresenter.immersive">
            <Setter Property="Foreground" Value="{DynamicResource ThemeImmersiveMenuTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource ThemeImmersiveMenuBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeImmersiveMenuBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="MinWidth" Value="232" />
        </Style>
        <Style Selector="MenuFlyoutPresenter.immersive MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource ThemeImmersiveMenuTextBrush}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style Selector="MenuFlyoutPresenter.immersive MenuItem:selected /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="{DynamicResource ThemeImmersiveMenuHoverBrush}" />
        </Style>
        <Style Selector="MenuFlyoutPresenter.immersive MenuItem:pressed /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="{DynamicResource ThemeImmersiveMenuPressedBrush}" />
        </Style>
        <Style Selector="MenuFlyoutPresenter.immersive MenuItem:disabled">
            <Setter Property="Foreground" Value="{DynamicResource ThemeImmersiveMenuDisabledTextBrush}" />
        </Style>
        <Style Selector="MenuFlyoutPresenter.immersive Separator">
            <Setter Property="Background" Value="{DynamicResource ThemeImmersiveMenuSeparatorBrush}" />
            <Setter Property="Margin" Value="10,5" />
        </Style>
        <Style Selector="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeOverlayBorderStrongBrush}" />
        </Style>
        <Style Selector="ToolTip">
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeOverlayBorderStrongBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
        </Style>

        <!--  Botones de reproducción (.icon, .skip, .play, .pp): los comparten MainWindow y la isla  -->
        <StyleInclude Source="avares://MusicPlayer.Desktop/Themes/PlayerButtonStyles.axaml" />

        <!--  Botones de acción (Classes="action"): barra superior y «+» de COLECCIONES; opt-in  -->
        <StyleInclude Source="avares://MusicPlayer.Desktop/Themes/ActionButtonStyles.axaml" />
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://MusicPlayer.Desktop/Themes/ThemeBrushes.axaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                Los nueve colores del tema. Estos valores son los del tema Oscuro y solo cubren el instante antes de
                que ThemeService aplique el tema elegido; después se reemplazan en tiempo de ejecución.
                ThemeAccent es el acento del sistema (lo fija ThemeService; este valor es solo de respaldo).
            -->
            <Color x:Key="ThemeBackground">#0F0F0F</Color>
            <Color x:Key="ThemeSurface">#000000</Color>
            <Color x:Key="ThemeOverlay">#FFFFFF</Color>
            <Color x:Key="ThemePrimary">#FFFFFF</Color>
            <Color x:Key="ThemeOnPrimary">#101010</Color>
            <Color x:Key="ThemeAccent">#0078D4</Color>
            <Color x:Key="ThemeDanger">#E57373</Color>
            <Color x:Key="ThemeSuccess">#4CAF50</Color>
            <Color x:Key="ThemeWarning">#FFB74D</Color>

            <!--  Mismas claves de Fluent en las dos variantes: el tema decide los colores, no la variante  -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <ResourceDictionary.MergedDictionaries>
                        <ResourceInclude Source="avares://MusicPlayer.Desktop/Themes/FluentOverrides.axaml" />
                    </ResourceDictionary.MergedDictionaries>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <ResourceDictionary.MergedDictionaries>
                        <ResourceInclude Source="avares://MusicPlayer.Desktop/Themes/FluentOverrides.axaml" />
                    </ResourceDictionary.MergedDictionaries>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
